<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập · <%= libraryName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif; }

    body {
      min-height: 100vh;
      background: linear-gradient(150deg, #1a1850 0%, #1e2060 30%, #1a2878 60%, #1e3a6e 100%);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden; padding: 24px;
    }

    /* Blobs trang trí */
    .blob { position: absolute; border-radius: 50%; pointer-events: none; z-index: 0; }
    .blob-1 {
      width: 500px; height: 500px;
      background: rgba(99,102,241,0.18); filter: blur(90px);
      top: -150px; left: -120px;
      animation: drift 10s ease-in-out infinite alternate;
    }
    .blob-2 {
      width: 400px; height: 400px;
      background: rgba(59,130,246,0.15); filter: blur(80px);
      bottom: -100px; right: -100px;
      animation: drift 13s ease-in-out infinite alternate-reverse;
    }
    .blob-3 {
      width: 260px; height: 260px;
      background: rgba(139,92,246,0.12); filter: blur(60px);
      top: 40%; right: 8%;
    }
    @keyframes drift {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(20px, 18px) scale(1.08); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── CARD ── */
    .login-card {
      position: relative; z-index: 10;
      width: 100%; max-width: 400px;
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(32px) saturate(160%);
      -webkit-backdrop-filter: blur(32px) saturate(160%);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 22px;
      box-shadow: 0 32px 80px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.12);
      overflow: hidden;
      animation: fadeInUp 0.48s cubic-bezier(0.16,1,0.3,1) both;
    }

    /* ── HEADER ── */
    .card-header {
      padding: 36px 32px 24px;
      text-align: center;
    }
    .logo-box {
      width: 72px; height: 72px;
      margin: 0 auto 18px;
      background: linear-gradient(145deg, #6366f1 0%, #4f46e5 60%, #3730a3 100%);
      border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 38px;
      box-shadow: 0 8px 28px rgba(79,70,229,0.50), inset 0 1px 0 rgba(255,255,255,0.25);
    }
    .card-title {
      font-size: 24px; font-weight: 800;
      color: #fff;
      letter-spacing: -0.02em;
      text-shadow: 0 2px 12px rgba(0,0,0,0.25);
    }

    /* ── ALERT ERROR ── */
    .alert-wrap { padding: 0 28px 12px; }
    .alert-error {
      display: flex; align-items: center; gap: 10px;
      background: rgba(248,113,113,0.15);
      border: 1px solid rgba(252,165,165,0.30);
      color: rgba(255,210,210,0.96);
      padding: 11px 16px;
      border-radius: 12px;
      font-size: 13px; font-weight: 500;
      backdrop-filter: blur(10px);
      animation: fadeInUp 0.3s ease;
    }
    .alert-error .err-icon { font-size: 16px; flex-shrink: 0; }

    /* ── FORM ── */
    .card-body { padding: 0 28px 24px; }

    .form-group { margin-bottom: 18px; }

    .form-label {
      display: block;
      font-size: 13.5px; font-weight: 600;
      color: rgba(255,255,255,0.92);
      margin-bottom: 8px;
      letter-spacing: 0.01em;
    }

    .input-wrap { position: relative; }
    .input-icon {
      position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
      font-size: 15px; opacity: 0.60; pointer-events: none;
    }
    .form-input {
      width: 100%;
      padding: 13px 16px 13px 42px;
      background: rgba(255,255,255,0.12);
      border: 1.5px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      color: #fff;
      font-size: 14px;
      backdrop-filter: blur(8px);
      transition: border-color 0.22s, background 0.22s, box-shadow 0.22s;
      outline: none;
    }
    .form-input::placeholder { color: rgba(255,255,255,0.40); font-size: 13.5px; }
    .form-input:focus {
      background: rgba(255,255,255,0.18);
      border-color: rgba(99,102,241,0.80);
      box-shadow: 0 0 0 3px rgba(99,102,241,0.25);
    }

    /* ── REMEMBER ── */
    .remember-row {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 20px;
      cursor: pointer; user-select: none;
    }
    .remember-row input[type="checkbox"] {
      width: 16px; height: 16px;
      accent-color: #6366f1;
      cursor: pointer;
    }
    .remember-row span {
      font-size: 13px; font-weight: 500;
      color: rgba(255,255,255,0.80);
    }

    /* ── SUBMIT BUTTON ── */
    .btn-login {
      width: 100%;
      padding: 14px 20px;
      border: none; border-radius: 12px;
      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 60%, #4338ca 100%);
      color: #fff;
      font-size: 15px; font-weight: 700;
      letter-spacing: 0.01em;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(79,70,229,0.50);
      transition: all 0.22s ease;
      margin-bottom: 16px;
    }
    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(79,70,229,0.65);
      background: linear-gradient(135deg, #7678ff 0%, #5c56f5 60%, #4f46e5 100%);
    }
    .btn-login:active { transform: translateY(1px) scale(0.99); }

    /* ── INFO BOX ── */
    .info-box {
      display: flex; align-items: center; gap: 9px;
      padding: 11px 15px;
      background: rgba(255,255,255,0.07);
      border: 1.5px dashed rgba(255,255,255,0.20);
      border-radius: 12px;
      font-size: 12.5px; color: rgba(255,255,255,0.65);
      line-height: 1.45;
    }
    .info-box .info-icon { font-size: 15px; flex-shrink: 0; }

    /* ── FOOTER ── */
    .card-footer {
      padding: 14px 28px 18px;
      text-align: center;
      font-size: 12.5px; color: rgba(255,255,255,0.45);
      letter-spacing: 0.02em;
    }
    .card-footer strong { color: rgba(255,255,255,0.70); font-weight: 600; }
  </style>
</head>
<body>

  <!-- Blobs trang trí -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <!-- Login Card -->
  <div class="login-card">

    <!-- Header -->
    <div class="card-header">
      <div class="logo-box">📚</div>
      <h1 class="card-title">Thư viện Mini</h1>
    </div>

    <!-- Flash Error -->
    <% if (error_msg) { %>
    <div class="alert-wrap">
      <div class="alert-error">
        <span class="err-icon">❌</span>
        <span><%= error_msg %></span>
      </div>
    </div>
    <% } %>

    <!-- Form -->
    <div class="card-body">
      <form action="/login" method="POST">

        <!-- Tài khoản -->
        <div class="form-group">
          <label class="form-label" for="studentId">Tài khoản</label>
          <div class="input-wrap">
            <span class="input-icon">🧑</span>
            <input
              type="text" id="studentId" name="studentId"
              class="form-input"
              placeholder="Nhập tên tài khoản..."
              required autocomplete="username"
            >
          </div>
        </div>

        <!-- Mật khẩu -->
        <div class="form-group">
          <label class="form-label" for="password">Mật khẩu</label>
          <div class="input-wrap">
            <span class="input-icon">🔒</span>
            <input
              type="password" id="password" name="password"
              class="form-input"
              placeholder="Nhập mật khẩu..."
              required autocomplete="current-password"
            >
          </div>
        </div>

        <!-- Ghi nhớ đăng nhập -->
        <label class="remember-row">
          <input type="checkbox" name="remember" checked>
          <span>Ghi nhớ đăng nhập</span>
        </label>

        <!-- Nút đăng nhập -->
        <button type="submit" class="btn-login">Đăng nhập</button>

        <!-- Info hint -->
        <div class="info-box">
          <span class="info-icon">📋</span>
          <span>Đăng nhập bằng tài khoản được cấp bởi quản trị viên.</span>
        </div>

      </form>
    </div>

    <!-- Footer -->
    <div class="card-footer">
      Thạc sĩ HUBT &nbsp;·&nbsp; K20.02 &nbsp;·&nbsp; <strong>Nhóm 4</strong>
    </div>

  </div>

</body>
</html>