<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tạo phiếu mượn · <%= libraryName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: linear-gradient(135deg,#e8edf8 0%,#ede8f8 50%,#e8f0fa 100%); background-attachment: fixed; min-height: 100vh; }

    .glass-card { background:rgba(255,255,255,0.72); backdrop-filter:blur(14px) saturate(180%); -webkit-backdrop-filter:blur(14px) saturate(180%); border:1px solid rgba(255,255,255,0.85); box-shadow:0 10px 36px rgba(79,70,229,0.08),0 2px 10px rgba(0,0,0,0.04); border-radius:20px; }
    .navbar-admin { background:rgba(79,70,229,0.92); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border-bottom:1px solid rgba(255,255,255,0.22); box-shadow:0 4px 24px rgba(79,70,229,0.25); }
    .sidebar { background:linear-gradient(180deg,#1e293b 0%,#0f172a 100%); border-right:1px solid rgba(255,255,255,0.06); box-shadow:4px 0 24px rgba(0,0,0,0.15); }
    .nav-item { color:rgba(255,255,255,0.58); border-radius:10px; border-left:3px solid transparent; margin:2px 10px; transition:all 0.2s ease; }
    .nav-item:hover { background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.92); transform:translateX(3px); border-left-color:rgba(99,102,241,0.4); }
    .nav-item.active { background:linear-gradient(90deg,rgba(79,70,229,0.38) 0%,rgba(79,70,229,0.06) 100%); border-left:3px solid #6366f1; color:#fff; font-weight:600; }
    .custom-input, .custom-select, .custom-textarea { background:rgba(255,255,255,0.85); border:1.5px solid rgba(226,232,240,0.95); border-radius:12px; transition:all 0.2s cubic-bezier(0.4,0,0.2,1); }
    .custom-input:focus, .custom-select:focus, .custom-textarea:focus { background:#fff; border-color:#4f46e5; box-shadow:0 0 0 4px rgba(79,70,229,0.12); outline:none; }
    .btn-primary-gradient { background:linear-gradient(135deg,#6366f1 0%,#4f46e5 100%); box-shadow:0 4px 16px rgba(79,70,229,0.35); transition:all 0.2s ease; }
    .btn-primary-gradient:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(79,70,229,0.45); }
    .btn-primary-gradient:active { transform:translateY(1px) scale(0.98); }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)} }
    .animate-fadeInUp { animation:fadeInUp 0.4s ease-out forwards; }
    ::-webkit-scrollbar{width:6px;} ::-webkit-scrollbar-track{background:transparent;} ::-webkit-scrollbar-thumb{background:rgba(79,70,229,0.3);border-radius:3px;}
  </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col antialiased">

  <!-- NAVBAR -->
  <header class="navbar-admin h-14 w-full flex items-center justify-between px-6 sticky top-0 z-50 text-white select-none">
    <a href="/admin" class="flex items-center space-x-3 no-underline text-white">
      <div class="w-8 h-8 rounded-lg bg-white/15 flex items-center justify-center border border-white/25 text-lg">📚</div>
      <span class="font-bold tracking-tight text-base"><%= libraryName %></span>
    </a>
    <div class="flex items-center space-x-4">
      <div class="flex items-center space-x-2 text-sm text-white/95 bg-white/10 px-3 py-1.5 rounded-full border border-white/15">
        <span class="w-2 h-2 rounded-full bg-emerald-400" style="box-shadow:0 0 8px rgba(52,211,153,0.8);"></span>
        <span class="text-xs text-white/75">Thủ thư:</span>
        <span class="font-semibold text-xs"><%= user ? user.fullName : 'Admin' %></span>
      </div>
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="flex items-center space-x-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white transition duration-200 cursor-pointer">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Đăng xuất</span>
        </button>
      </form>
    </div>
  </header>

  <!-- LAYOUT -->
  <div class="flex flex-1 w-full relative">

    <!-- SIDEBAR -->
    <aside class="sidebar w-60 flex-shrink-0 min-h-[calc(100vh-3.5rem)] py-5 flex flex-col select-none">
      <div class="space-y-6">
        <div class="px-2">
          <a href="/admin" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
            <svg class="w-4 h-4 text-[#818cf8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
            <span>Dashboard</span>
          </a>
        </div>
        <div>
          <div class="px-5 pb-2 text-[10px] uppercase font-bold tracking-widest text-white/30 border-t border-white/[0.07] pt-3">Quản lý</div>
          <div class="space-y-1 px-2">
            <a href="/admin/books" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#34d399]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 016.5 2H20v20H6.5a2.5 2.5 0 01-2.5-2.5z"/><path d="M6 2v20"/></svg>
              <span>Quản lý sách</span>
            </a>
            <a href="/admin/students" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#60a5fa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
              <span>Quản lý học sinh</span>
            </a>
          </div>
        </div>
        <div>
          <div class="px-5 pb-2 text-[10px] uppercase font-bold tracking-widest text-white/30 border-t border-white/[0.07] pt-3">Nghiệp vụ</div>
          <div class="space-y-1 px-2">
            <a href="/admin/borrow" class="nav-item active flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#a78bfa]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              <span>Mượn sách</span>
            </a>
            <a href="/admin/return" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#4ade80]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/></svg>
              <span>Trả sách</span>
            </a>
            <a href="/admin/borrowings" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#facc15]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><path d="M12 11h4M12 16h4M8 11h.01M8 16h.01"/></svg>
              <span>Danh sách mượn</span>
            </a>
          </div>
        </div>
        <div>
          <div class="px-5 pb-2 text-[10px] uppercase font-bold tracking-widest text-white/30 border-t border-white/[0.07] pt-3">Báo cáo</div>
          <div class="space-y-1 px-2">
            <a href="/admin/reports" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 text-sm">
              <svg class="w-4 h-4 text-[#f87171]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
              <span>Báo cáo thống kê</span>
            </a>
          </div>
        </div>
      </div>
    </aside>

    <!-- CONTENT -->
    <main class="flex-1 p-8 overflow-y-auto">
      <div class="max-w-4xl mx-auto animate-fadeInUp space-y-6">

        <!-- Breadcrumb -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center space-x-4">
            <a href="/admin/borrowings" class="inline-flex items-center space-x-2 text-xs font-semibold px-3.5 py-2 rounded-xl bg-white/70 hover:bg-white border border-slate-200 text-slate-700 hover:text-indigo-600 shadow-sm transition duration-200 no-underline">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              <span>Danh sách phiếu mượn</span>
            </a>
            <div class="h-5 w-px bg-slate-300"></div>
            <span class="text-xs text-slate-500 font-medium">Nghiệp vụ lưu thông thư viện</span>
          </div>
          <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-indigo-50/80 border border-indigo-200/80 text-indigo-700 text-xs font-medium">
            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
            <span>Hệ thống sẵn sàng tạo phiếu mới</span>
          </div>
        </div>

        <!-- Page title -->
        <div class="flex items-center space-x-3.5">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center text-white shadow-lg" style="box-shadow:0 8px 20px rgba(79,70,229,0.3);">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          </div>
          <div>
            <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight">Tạo phiếu mượn sách</h1>
            <p class="text-sm text-slate-500 mt-0.5">Lập phiếu mượn tài liệu mới cho học sinh và kích hoạt đếm lùi hạn trả sách</p>
          </div>
        </div>

        <!-- Flash messages -->
        <% if (success_msg) { %>
        <div class="rounded-2xl p-4 flex items-start space-x-3.5 bg-emerald-50/80 border border-emerald-200/70 shadow-sm">
          <div class="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0 text-sm">✅</div>
          <div class="flex-1 text-sm text-emerald-800"><%= success_msg %></div>
          <button onclick="this.parentElement.remove()" class="text-emerald-700 font-bold text-base px-1">×</button>
        </div>
        <% } %>
        <% if (error_msg) { %>
        <div class="rounded-2xl p-4 flex items-start space-x-3.5 bg-red-50/80 border border-red-200/70 shadow-sm">
          <div class="w-7 h-7 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0 text-sm">❌</div>
          <div class="flex-1 text-sm text-red-800"><%= error_msg %></div>
          <button onclick="this.parentElement.remove()" class="text-red-700 font-bold text-base px-1">×</button>
        </div>
        <% } %>

        <!-- Info box quy định -->
        <div class="rounded-2xl p-4 flex items-start space-x-3.5 bg-blue-50/80 border border-blue-200/70 shadow-sm backdrop-blur-sm">
          <div class="w-7 h-7 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0 text-blue-600 font-bold text-sm">ℹ️</div>
          <div class="flex-1">
            <div class="text-sm font-semibold text-blue-900 flex items-center flex-wrap gap-2">
              <span>Quy định mượn trả hiện hành:</span>
              <span class="px-2 py-0.5 text-[11px] font-bold bg-blue-600 text-white rounded-full">Thời hạn: 7 ngày</span>
              <span class="px-2 py-0.5 text-[11px] font-bold bg-indigo-600 text-white rounded-full">Tối đa: 3 cuốn/học sinh</span>
            </div>
            <p class="text-xs text-blue-700/90 mt-1 leading-relaxed">
              Hệ thống tự động ghi nhận thời điểm mượn hôm nay và đặt hạn trả sau 7 ngày. Khi quá hạn, phí phạt được tính <strong>50.000 đ/ngày</strong> cho mỗi cuốn sách quá hạn.
            </p>
          </div>
        </div>

        <!-- FORM CARD -->
        <% if (availableBooks && availableBooks.length > 0) { %>
        <div class="glass-card p-7 sm:p-8 max-w-2xl mx-auto">

          <!-- Card header -->
          <div class="flex items-center justify-between border-b border-slate-200/70 pb-4 mb-6">
            <div class="flex items-center space-x-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-indigo-600" style="box-shadow:0 0 8px rgba(79,70,229,0.6);"></span>
              <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700">Thông tin phiếu mượn</h2>
            </div>
            <span class="text-xs text-slate-400 font-mono">Biểu mẫu chuẩn: BM-PM01</span>
          </div>

          <form action="/admin/borrow" method="POST" class="space-y-6">

            <!-- Chọn học sinh -->
            <div>
              <label for="userId" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Chọn học sinh <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <select id="userId" name="userId" required
                  class="custom-select w-full px-4 py-3 text-sm text-slate-800 appearance-none pr-10 cursor-pointer font-medium"
                  onchange="updateStudentPreview(this)">
                  <option value="" disabled selected>-- Tìm và chọn học sinh mượn sách --</option>
                  <% students.forEach(function(s) { %>
                    <option value="<%= s._id %>"
                      data-name="<%= s.fullName %>"
                      data-id="<%= s.studentId %>">
                      <%= s.fullName %> (<%= s.studentId %>)<%= s.class ? ' - Lớp ' + s.class : '' %>
                    </option>
                  <% }); %>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-500">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="mt-2.5 px-3.5 py-2 rounded-xl bg-slate-100/70 border border-slate-200/60 flex items-center justify-between text-xs text-slate-600" id="student-preview">
                <div class="flex items-center space-x-2">
                  <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                  <span>Chưa chọn học sinh</span>
                </div>
                <span class="font-mono text-slate-500 text-[11px]">—</span>
              </div>
            </div>

            <!-- Chọn sách -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="bookId" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                  Chọn cuốn sách <span class="text-red-500">*</span>
                </label>
                <span class="text-[11px] text-emerald-600 font-semibold bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-100">
                  Chỉ hiển thị sách sẵn sàng trong kho
                </span>
              </div>
              <div class="relative">
                <select id="bookId" name="bookId" required
                  class="custom-select w-full px-4 py-3 text-sm text-slate-800 appearance-none pr-10 cursor-pointer font-medium"
                  onchange="updateBookPreview(this)">
                  <option value="" disabled selected>-- Chọn cuốn sách cần mượn --</option>
                  <% availableBooks.forEach(function(b) { %>
                    <option value="<%= b._id %>"
                      data-category="<%= b.category || 'Không phân loại' %>"
                      data-available="<%= b.availableCopies %>">
                      <%= b.title %><% if (b.author) { %> — <%= b.author %><% } %> (Còn: <%= b.availableCopies %> bản)
                    </option>
                  <% }); %>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-500">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
              <div class="mt-2.5 px-3.5 py-2 rounded-xl bg-slate-100/70 border border-slate-200/60 flex items-center justify-between text-xs text-slate-600" id="book-preview">
                <span>Thể loại: <strong class="text-slate-800" id="book-category">—</strong></span>
                <span class="text-slate-500 text-[11px]" id="book-available">Chưa chọn sách</span>
              </div>
            </div>

            <!-- Ngày mượn & Hạn trả (readonly, tự động) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
              <div class="p-3.5 rounded-xl bg-white/60 border border-slate-200/70">
                <span class="block text-[11px] font-bold uppercase text-slate-400">Ngày mượn sách</span>
                <div class="flex items-center space-x-2 mt-1">
                  <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span class="font-bold text-sm text-slate-800" id="today-date"></span>
                  <span class="text-[10px] text-slate-400">(Hôm nay)</span>
                </div>
              </div>
              <div class="p-3.5 rounded-xl bg-indigo-50/50 border border-indigo-100">
                <span class="block text-[11px] font-bold uppercase text-indigo-400">Hạn trả dự kiến</span>
                <div class="flex items-center space-x-2 mt-1">
                  <svg class="w-4 h-4 text-indigo-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span class="font-bold text-sm text-indigo-700" id="due-date"></span>
                  <span class="text-[10px] font-semibold text-indigo-600 bg-indigo-100 px-1.5 py-0.5 rounded">(+7 ngày)</span>
                </div>
              </div>
            </div>

            <!-- Ghi chú -->
            <div>
              <label for="notes" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
                Ghi chú phiếu mượn
              </label>
              <textarea id="notes" name="notes" rows="2"
                placeholder="Tình trạng sách khi giao, ký hiệu bìa, ghi chú nhắc nhở của thủ thư..."
                class="custom-textarea w-full px-4 py-2.5 text-sm text-slate-800 placeholder-slate-400"></textarea>
              <p class="text-[11px] text-slate-400 mt-1">Không bắt buộc. Ghi chú giúp đối soát khi học sinh hoàn trả sách.</p>
            </div>

            <!-- Action buttons -->
            <div class="pt-4 border-t border-slate-200/70 flex flex-col sm:flex-row items-center justify-between gap-3">
              <div class="flex items-center space-x-2 text-xs text-slate-500">
                <span class="text-red-500 font-bold">*</span>
                <span>Thông tin bắt buộc phải chọn</span>
              </div>
              <div class="flex items-center space-x-3 w-full sm:w-auto">
                <a href="/admin/borrowings" class="w-1/2 sm:w-auto text-center px-5 py-2.5 text-xs font-semibold rounded-xl bg-white/80 hover:bg-white text-slate-600 hover:text-slate-800 border border-slate-300 shadow-sm transition no-underline">
                  Hủy bỏ
                </a>
                <button type="submit" class="w-1/2 sm:w-auto flex items-center justify-center space-x-2 px-6 py-2.5 text-xs font-bold rounded-xl text-white btn-primary-gradient shadow-md cursor-pointer">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></svg>
                  <span>📋 Tạo phiếu mượn</span>
                </button>
              </div>
            </div>

          </form>
        </div>
        <% } else { %>
        <!-- Không có sách -->
        <div class="glass-card p-10 max-w-2xl mx-auto text-center">
          <div class="text-5xl mb-4">📭</div>
          <h3 class="text-lg font-bold text-slate-700 mb-2">Hiện tại không có sách sẵn trong kho</h3>
          <p class="text-sm text-slate-500 mb-6">Tất cả sách đang được mượn hoặc chưa có sách trong hệ thống.</p>
          <div class="flex items-center justify-center gap-3">
            <a href="/admin/books/add" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 text-white text-sm font-semibold shadow-md hover:shadow-lg transition no-underline">
              ➕ Thêm sách mới
            </a>
            <a href="/admin/return" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/80 border border-slate-200 text-slate-700 text-sm font-semibold shadow-sm hover:bg-white transition no-underline">
              ✓ Xử lý trả sách
            </a>
          </div>
        </div>
        <% } %>

      </div>
    </main>
  </div>

  <script>
    // Ngày mượn & hạn trả tự động
    (function() {
      const today = new Date();
      const due   = new Date(today); due.setDate(due.getDate() + 7);
      const fmt   = d => d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' });
      const todayEl = document.getElementById('today-date');
      const dueEl   = document.getElementById('due-date');
      if (todayEl) todayEl.textContent = fmt(today);
      if (dueEl)   dueEl.textContent   = fmt(due);
    })();

    // Preview học sinh khi chọn
    function updateStudentPreview(sel) {
      const opt = sel.options[sel.selectedIndex];
      const preview = document.getElementById('student-preview');
      if (!preview || !opt.value) return;
      preview.innerHTML = `
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Tài khoản hợp lệ: <strong class="text-slate-800">${opt.dataset.name}</strong></span>
        </div>
        <span class="font-mono text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded text-[11px] font-semibold">Mã: ${opt.dataset.id}</span>
      `;
    }

    // Preview sách khi chọn
    function updateBookPreview(sel) {
      const opt = sel.options[sel.selectedIndex];
      const catEl = document.getElementById('book-category');
      const availEl = document.getElementById('book-available');
      if (!catEl || !opt.value) return;
      catEl.textContent = opt.dataset.category || '—';
      availEl.textContent = `Sẵn có ${opt.dataset.available} cuốn trong kho`;
      availEl.className = 'text-emerald-700 font-semibold bg-emerald-100/70 px-2 py-0.5 rounded text-[11px]';
    }
  </script>

</body>
</html>