<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý sách · <%= libraryName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --primary: #4f46e5;
      --danger:  #dc2626;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --glass-hover-shadow: 0 16px 36px rgba(79,70,229,0.14), 0 4px 12px rgba(0,0,0,0.06);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }

    body {
      background: linear-gradient(135deg, #e8edf8 0%, #ede8f8 50%, #e8f0fa 100%);
      background-attachment: fixed;
      min-height: 100vh; color: #1e293b; overflow-x: hidden;
    }

    /* Glassmorphism */
    .glass {
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(14px) saturate(180%);
      -webkit-backdrop-filter: blur(14px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.85);
      box-shadow: 0 8px 32px rgba(79,70,229,0.08), 0 2px 8px rgba(0,0,0,0.04);
      border-radius: 16px;
    }

    /* Navbar */
    .navbar-admin {
      background: rgba(79,70,229,0.90);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.20);
      box-shadow: 0 4px 24px rgba(79,70,229,0.25);
      position: sticky; top: 0; z-index: 100; height: 56px;
      display: flex; align-items: center; justify-content: space-between; padding: 0 24px;
    }
    .nav-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .nav-brand-logo {
      width: 32px; height: 32px; border-radius: 8px;
      background: rgba(255,255,255,0.20);
      display: flex; align-items: center; justify-content: center; font-size: 18px;
      border: 1px solid rgba(255,255,255,0.25);
    }
    .nav-brand-name { font-weight: 700; font-size: 14px; color: #fff; letter-spacing: 0.01em; }

    /* Sidebar */
    .sidebar {
      background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
      border-right: 1px solid rgba(255,255,255,0.06);
      box-shadow: 4px 0 24px rgba(0,0,0,0.15);
      width: 230px; min-height: calc(100vh - 56px);
      padding: 16px 0; display: flex; flex-direction: column;
    }
    .nav-link {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 14px; margin: 3px 10px;
      color: rgba(255,255,255,0.60); font-size: 13px; font-weight: 500;
      border-radius: 8px; border-left: 3px solid transparent;
      text-decoration: none; transition: all 0.2s ease;
    }
    .nav-link:hover {
      background: rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.92);
      transform: translateX(3px);
      border-left-color: rgba(99,102,241,0.5);
    }
    .nav-link.active {
      background: linear-gradient(90deg, rgba(79,70,229,0.38) 0%, rgba(79,70,229,0.08) 100%);
      border-left: 3px solid #6366f1;
      color: #fff; font-weight: 600;
    }
    .sidebar-group-label {
      font-size: 10px; text-transform: uppercase;
      color: rgba(255,255,255,0.35); letter-spacing: 1.5px; font-weight: 700;
      padding: 14px 14px 6px;
      border-top: 1px solid rgba(255,255,255,0.08); margin-top: 8px;
    }
    .nav-icon { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; flex-shrink: 0; }

    /* Layout */
    .layout-wrapper { display: flex; }
    .content-area { flex: 1; padding: 28px; overflow-y: auto; }

    /* Page header */
    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
      margin-bottom: 24px; flex-wrap: wrap;
    }
    .page-title { font-size: 22px; font-weight: 800; color: var(--slate-800); display: flex; align-items: center; gap: 8px; }
    .page-subtitle { font-size: 13px; color: var(--slate-500); margin-top: 4px; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 18px; border-radius: 10px; font-size: 13.5px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: all 0.2s ease; border: none;
    }
    .btn-primary {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      box-shadow: 0 4px 14px rgba(79,70,229,0.30); color: #fff;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(79,70,229,0.45); }
    .btn-outline-primary {
      background: rgba(255,255,255,0.60); color: var(--primary);
      border: 1.5px solid var(--primary);
    }
    .btn-outline-primary:hover {
      background: rgba(79,70,229,0.08);
      transform: translateY(-1px); box-shadow: 0 4px 12px rgba(79,70,229,0.15);
    }

    /* Alert */
    .alert {
      backdrop-filter: blur(8px); border-radius: 12px;
      padding: 12px 18px; margin-bottom: 20px;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      font-size: 13.5px; animation: fadeInUp 0.3s ease;
    }
    .alert-success { background: rgba(240,253,244,0.88); border: 1px solid rgba(187,247,208,0.85); color: #15803d; box-shadow: 0 4px 16px rgba(22,163,74,0.08); }
    .alert-error   { background: rgba(254,242,242,0.88); border: 1px solid rgba(252,165,165,0.85); color: #b91c1c; box-shadow: 0 4px 16px rgba(220,38,38,0.08); }
    .alert-content { display: flex; align-items: center; gap: 10px; }
    .alert-close { background: none; border: none; font-size: 18px; color: currentColor; cursor: pointer; opacity: 0.6; transition: opacity 0.15s; line-height: 1; }
    .alert-close:hover { opacity: 1; }

    /* Summary strip */
    .summary-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 22px; }
    .summary-item { padding: 14px 18px; display: flex; align-items: center; gap: 14px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .summary-item:hover { transform: translateY(-2px); box-shadow: var(--glass-hover-shadow); }
    .summary-icon-wrap { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .summary-label { font-size: 11px; color: var(--slate-500); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .summary-val { font-size: 22px; font-weight: 800; color: var(--slate-800); display: block; }

    /* Filter card */
    .filter-card { margin-bottom: 20px; padding: 16px 20px; }
    .filter-form { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .search-input-group { position: relative; flex: 1; min-width: 220px; }
    .search-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); font-size: 15px; pointer-events: none; }
    .form-control {
      width: 100%; padding: 9px 14px 9px 38px;
      background: rgba(255,255,255,0.70); border: 1.5px solid rgba(203,213,225,0.80);
      border-radius: 9px; font-size: 13.5px; color: var(--slate-700); outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
    .select-category {
      padding: 9px 14px; background: rgba(255,255,255,0.70);
      border: 1.5px solid rgba(203,213,225,0.80); border-radius: 9px;
      font-size: 13.5px; color: var(--slate-700); cursor: pointer; outline: none;
    }
    .select-category:focus { border-color: #6366f1; }

    /* Table container */
    .table-container-card { overflow: hidden; margin-bottom: 0; }
    .table-header-info { padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(226,232,240,0.7); }
    .table-title { font-size: 14px; font-weight: 700; color: var(--slate-800); display: flex; align-items: center; gap: 8px; }
    .table-responsive { overflow-x: auto; }

    table { width: 100%; border-collapse: collapse; text-align: left; }
    thead tr { background: rgba(79,70,229,0.06); }
    th { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--slate-500); padding: 12px 18px; white-space: nowrap; border-bottom: 1px solid rgba(226,232,240,0.8); }
    th.center, td.center { text-align: center; }
    th.right, td.right { text-align: right; }
    tbody tr { border-bottom: 1px solid rgba(241,245,249,0.9); transition: background 0.15s ease; }
    tbody tr:hover { background: rgba(79,70,229,0.04); }
    tbody tr.out-of-stock { background: rgba(220,38,38,0.025); }
    tbody tr.out-of-stock:hover { background: rgba(220,38,38,0.05); }
    td { padding: 13px 18px; font-size: 13px; color: var(--slate-700); vertical-align: middle; }

    .col-idx { color: var(--slate-400); font-weight: 500; font-size: 12px; width: 44px; }
    .book-title-cell { display: flex; flex-direction: column; gap: 3px; }
    .book-title { font-weight: 600; color: var(--slate-800); font-size: 13.5px; text-decoration: none; transition: color 0.15s; }
    .book-title:hover { color: var(--primary); }
    .book-isbn { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--slate-400); }
    .book-author { font-weight: 500; color: var(--slate-700); }
    .book-publisher { font-size: 12px; color: var(--slate-400); }

    /* Badges */
    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .badge-category     { background: #64748b; color: #fff; box-shadow: 0 2px 6px rgba(100,116,139,0.25); }
    .badge-stock-available { background: #16a34a; color: #fff; box-shadow: 0 2px 8px rgba(22,163,74,0.35); }
    .badge-stock-empty  { background: #dc2626; color: #fff; box-shadow: 0 2px 8px rgba(220,38,38,0.35); }
    .badge-stock-low    { background: #d97706; color: #fff; box-shadow: 0 2px 8px rgba(217,119,6,0.35); }

    /* Action buttons */
    .action-group { display: inline-flex; align-items: center; gap: 6px; justify-content: flex-end; }
    .btn-icon {
      width: 32px; height: 32px; border-radius: 7px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 13.5px; cursor: pointer; text-decoration: none;
      transition: all 0.2s ease; border: 1.5px solid transparent; background: transparent;
    }
    .btn-icon-edit { border-color: rgba(79,70,229,0.4); color: var(--primary); background: rgba(79,70,229,0.05); }
    .btn-icon-edit:hover { background: var(--primary); color: #fff; border-color: var(--primary); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(79,70,229,0.25); }
    .btn-icon-delete { border-color: rgba(220,38,38,0.4); color: var(--danger); background: rgba(220,38,38,0.05); }
    .btn-icon-delete:hover { background: var(--danger); color: #fff; border-color: var(--danger); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(220,38,38,0.25); }

    /* Table footer */
    .table-footer {
      padding: 12px 20px; border-top: 1px solid rgba(226,232,240,0.8);
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(255,255,255,0.5); font-size: 12.5px; color: var(--slate-500); flex-wrap: wrap; gap: 12px;
    }

    /* Empty state */
    .empty-state { padding: 48px 20px; text-align: center; color: var(--slate-400); }
    .empty-state-icon { font-size: 40px; margin-bottom: 12px; }
    .empty-state-text { font-size: 14px; font-weight: 500; }
    .empty-state-sub  { font-size: 12.5px; margin-top: 4px; }

    /* Animations */
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    .page-content { animation: fadeInUp 0.4s ease both; }

    /* User info in navbar */
    .nav-user { display: flex; align-items: center; gap: 16px; }
    .nav-user-info { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.12); padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.20); }
    .nav-user-name { font-size: 12.5px; color: rgba(255,255,255,0.90); font-weight: 500; }
    .btn-logout { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.30); color: rgba(255,255,255,0.90); font-size: 12px; font-weight: 500; background: transparent; cursor: pointer; transition: all 0.2s; }
    .btn-logout:hover { background: rgba(255,255,255,0.15); color: #fff; }
  </style>
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <header class="navbar-admin">
    <a href="/admin" class="nav-brand">
      <div class="nav-brand-logo">📚</div>
      <span class="nav-brand-name"><%= libraryName %></span>
    </a>
    <div class="nav-user">
      <div class="nav-user-info">
        <span style="font-size:14px;">👤</span>
        <span class="nav-user-name">Thủ thư: <strong><%= user ? user.fullName : 'Admin' %></strong></span>
        <span style="width:8px;height:8px;border-radius:50%;background:#34d399;display:inline-block;box-shadow:0 0 8px #34d399;"></span>
      </div>
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="btn-logout">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Đăng xuất
        </button>
      </form>
    </div>
  </header>

  <!-- ===== LAYOUT ===== -->
  <div class="layout-wrapper">

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar">
      <a href="/admin" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></span>
        <span>Dashboard</span>
      </a>

      <div class="sidebar-group-label">QUẢN LÝ</div>

      <a href="/admin/books" class="nav-link active">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></span>
        <span>Quản lý sách</span>
      </a>
      <a href="/admin/students" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
        <span>Quản lý học sinh</span>
      </a>

      <div class="sidebar-group-label">NGHIỆP VỤ</div>

      <a href="/admin/borrow" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg></span>
        <span>Mượn sách</span>
      </a>
      <a href="/admin/return" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/></svg></span>
        <span>Trả sách</span>
      </a>
      <a href="/admin/borrowings" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><path d="M12 11h4M12 16h4M8 11h.01M8 16h.01"/></svg></span>
        <span>Danh sách mượn</span>
      </a>

      <div class="sidebar-group-label">BÁO CÁO</div>

      <a href="/admin/reports" class="nav-link">
        <span class="nav-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></span>
        <span>Báo cáo thống kê</span>
      </a>
    </aside>

    <!-- ===== CONTENT ===== -->
    <main class="content-area page-content">

      <!-- Page header -->
      <div class="page-header">
        <div class="header-titles">
          <h1 class="page-title"><span>📚</span> Quản lý sách</h1>
          <p class="page-subtitle">Quản lý kho sách, tra cứu số lượng và điều chỉnh thông tin sách trong thư viện</p>
        </div>
        <a href="/admin/books/add" class="btn btn-primary">
          <span>➕</span>
          <span>Thêm sách mới</span>
        </a>
      </div>

      <!-- Flash messages -->
      <% if (success_msg) { %>
      <div class="alert alert-success">
        <div class="alert-content">
          <span style="font-size:16px;">✅</span>
          <span><%= success_msg %></span>
        </div>
        <button class="alert-close" onclick="this.parentElement.style.display='none'">×</button>
      </div>
      <% } %>
      <% if (error_msg) { %>
      <div class="alert alert-error">
        <div class="alert-content">
          <span style="font-size:16px;">❌</span>
          <span><%= error_msg %></span>
        </div>
        <button class="alert-close" onclick="this.parentElement.style.display='none'">×</button>
      </div>
      <% } %>

      <!-- Summary strip -->
      <%
        const totalCopies   = books ? books.reduce((s, b) => s + (b.totalCopies || 0), 0) : 0;
        const availCopies   = books ? books.reduce((s, b) => s + (b.availableCopies || 0), 0) : 0;
        const borrowedCopies= totalCopies - availCopies;
        const emptyBooks    = books ? books.filter(b => b.availableCopies === 0).length : 0;
      %>
      <div class="summary-strip">
        <div class="glass summary-item">
          <div class="summary-icon-wrap" style="background:rgba(79,70,229,0.12);color:rgb(79,70,229);">📚</div>
          <div class="summary-text">
            <span class="summary-label">Tổng đầu sách</span>
            <span class="summary-val"><%= books ? books.length : 0 %></span>
          </div>
        </div>
        <div class="glass summary-item">
          <div class="summary-icon-wrap" style="background:rgba(22,163,74,0.12);color:rgb(22,163,74);">📦</div>
          <div class="summary-text">
            <span class="summary-label">Tổng số bản</span>
            <span class="summary-val"><%= totalCopies.toLocaleString('vi-VN') %></span>
          </div>
        </div>
        <div class="glass summary-item">
          <div class="summary-icon-wrap" style="background:rgba(37,99,235,0.12);color:rgb(37,99,235);">📖</div>
          <div class="summary-text">
            <span class="summary-label">Đang cho mượn</span>
            <span class="summary-val"><%= borrowedCopies %></span>
          </div>
        </div>
        <div class="glass summary-item">
          <div class="summary-icon-wrap" style="background:rgba(220,38,38,0.12);color:rgb(220,38,38);">⚠️</div>
          <div class="summary-text">
            <span class="summary-label">Hết bản sao</span>
            <span class="summary-val" style="color:rgb(220,38,38);"><%= String(emptyBooks).padStart(2,'0') %></span>
          </div>
        </div>
      </div>

      <!-- Filter & search -->
      <div class="glass filter-card">
        <form method="GET" action="/admin/books" class="filter-form">
          <div class="search-input-group">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" class="form-control"
              placeholder="Tìm theo tên sách hoặc tác giả..."
              value="<%= search || '' %>">
          </div>
          <select name="category" class="select-category">
            <option value="">Tất cả thể loại</option>
            <% ['Sách giáo khoa','Sách tham khảo','Truyện','Bách khoa','Khác'].forEach(function(c){ %>
              <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-outline-primary">
            <span>🔍</span><span>Tìm kiếm</span>
          </button>
          <% if (search || category) { %>
          <a href="/admin/books" class="btn" style="background:rgba(255,255,255,0.6);border:1.5px solid #94a3b8;color:#64748b;">✕ Xóa lọc</a>
          <% } %>
        </form>
      </div>

      <!-- Books table -->
      <div class="glass table-container-card">
        <div class="table-header-info">
          <div class="table-title">📋 Danh sách các tựa sách hiện có</div>
          <div style="font-size:12.5px;color:var(--slate-500);">
            Hiển thị <strong><%= books ? books.length : 0 %></strong> cuốn
            <% if (search || category) { %><span style="color:#6366f1;"> (đã lọc)</span><% } %>
          </div>
        </div>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th class="col-idx">#</th>
                <th>Tên sách</th>
                <th>Tác giả</th>
                <th>Thể loại</th>
                <th>Nhà xuất bản</th>
                <th class="center">Tổng</th>
                <th class="center">Còn lại</th>
                <th class="right">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              <% if (books && books.length > 0) { %>
                <% books.forEach(function(book, idx) { %>
                  <tr class="<%= book.availableCopies === 0 ? 'out-of-stock' : '' %>">
                    <td class="col-idx"><%= String(idx + 1).padStart(2, '0') %></td>
                    <td>
                      <div class="book-title-cell">
                        <a href="/admin/books/<%= book._id %>/edit" class="book-title"><%= book.title %></a>
                        <span class="book-isbn">Mã: <%= book._id.toString().slice(-6).toUpperCase() %></span>
                      </div>
                    </td>
                    <td><span class="book-author"><%= book.author || '—' %></span></td>
                    <td><span class="badge badge-category"><%= book.category || 'Khác' %></span></td>
                    <td><span class="book-publisher"><%= book.publisher || '—' %></span></td>
                    <td class="center"><strong><%= book.totalCopies %></strong></td>
                    <td class="center">
                      <% if (book.availableCopies === 0) { %>
                        <span class="badge badge-stock-empty">Hết sách (0 bản)</span>
                      <% } else if (book.availableCopies <= 2) { %>
                        <span class="badge badge-stock-low">Còn <%= book.availableCopies %> bản</span>
                      <% } else { %>
                        <span class="badge badge-stock-available">Còn <%= book.availableCopies %> bản</span>
                      <% } %>
                    </td>
                    <td class="right">
                      <div class="action-group">
                        <a href="/admin/books/<%= book._id %>/edit" class="btn-icon btn-icon-edit" title="Sửa thông tin sách">✏️</a>
                        <form method="POST" action="/admin/books/<%= book._id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa sách này?');">
                          <input type="hidden" name="_method" value="DELETE">
                          <button type="submit" class="btn-icon btn-icon-delete" title="Xóa sách">🗑️</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8">
                    <div class="empty-state">
                      <div class="empty-state-icon">📭</div>
                      <div class="empty-state-text">
                        <% if (search || category) { %>Không tìm thấy sách phù hợp<% } else { %>Chưa có sách nào trong thư viện<% } %>
                      </div>
                      <div class="empty-state-sub">
                        <% if (search || category) { %><a href="/admin/books" style="color:#6366f1;">Xóa bộ lọc</a> hoặc <a href="/admin/books/add" style="color:#6366f1;">thêm sách mới</a><% } else { %><a href="/admin/books/add" style="color:#6366f1;">Thêm sách đầu tiên →</a><% } %>
                      </div>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Table footer -->
        <div class="table-footer">
          <div>Tổng cộng <strong><%= books ? books.length : 0 %></strong> đầu sách · <strong><%= totalCopies %></strong> bản · Còn lại <strong><%= availCopies %></strong> bản</div>
          <% if (emptyBooks > 0) { %>
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="width:10px;height:10px;border-radius:2px;background:#fee2e2;border:1px solid #fca5a5;display:inline-block;"></span>
            <span><%= emptyBooks %> tựa sách đã hết bản sao</span>
          </div>
          <% } %>
        </div>

      </div>

    </main>
  </div>

</body>
</html>