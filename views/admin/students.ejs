<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý học sinh · <%= libraryName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --primary: #4f46e5; --primary-hover: #4338ca;
      --danger: #dc2626; --warning: #d97706; --success: #16a34a;
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      color: #334155;
      background: linear-gradient(135deg, #e8edf8 0%, #ede8f8 50%, #e8f0fa 100%);
      background-attachment: fixed;
      min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(79,70,229,0.3); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(79,70,229,0.6); }

    /* Navbar */
    .navbar-admin {
      height: 56px;
      background: rgba(79,70,229,0.90); backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,0.22);
      box-shadow: 0 4px 24px rgba(79,70,229,0.25);
      position: sticky; top: 0; z-index: 1000;
      display: flex; align-items: center; justify-content: space-between; padding: 0 24px; color: #fff;
    }
    .nav-brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: #fff; }
    .brand-icon-box { width: 36px; height: 36px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .brand-title { font-size: 15px; font-weight: 700; }
    .user-pill { display: flex; align-items: center; gap: 9px; background: rgba(255,255,255,0.14); padding: 6px 14px; border-radius: 30px; font-size: 13px; font-weight: 500; border: 1px solid rgba(255,255,255,0.2); }
    .status-dot { width: 8px; height: 8px; background: #4ade80; border-radius: 50%; box-shadow: 0 0 8px #4ade80; flex-shrink: 0; }
    .btn-logout { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.35); border-radius: 8px; padding: 6px 14px; font-size: 12px; font-weight: 600; text-decoration: none; transition: all 0.2s ease; cursor: pointer; }
    .btn-logout:hover { background: rgba(255,255,255,0.28); transform: translateY(-1px); }
    .nav-user-area { display: flex; align-items: center; gap: 16px; }

    /* Sidebar */
    .main-body { display: flex; flex: 1; }
    .sidebar { width: 230px; background: linear-gradient(180deg,#1e293b 0%,#0f172a 100%); border-right: 1px solid rgba(255,255,255,0.06); box-shadow: 4px 0 24px rgba(0,0,0,0.15); display: flex; flex-direction: column; padding: 20px 0; flex-shrink: 0; min-height: calc(100vh - 56px); }
    .nav-group-title { font-size: 10px; text-transform: uppercase; color: rgba(255,255,255,0.35); letter-spacing: 1.5px; font-weight: 700; padding: 14px 20px 6px; margin-top: 6px; border-top: 1px solid rgba(255,255,255,0.06); }
    .nav-item { display: flex; align-items: center; gap: 12px; padding: 9px 16px; margin: 2px 10px; border-radius: 8px; border-left: 3px solid transparent; color: rgba(255,255,255,0.60); font-size: 13px; font-weight: 500; text-decoration: none; transition: all 0.2s ease; }
    .nav-item:hover { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.9); transform: translateX(4px); border-left-color: rgba(99,102,241,0.5); }
    .nav-item.active { background: linear-gradient(90deg,rgba(79,70,229,0.38) 0%,transparent 100%); border-left: 3px solid #6366f1; color: #fff; font-weight: 600; }
    .nav-icon { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .icon-dashboard { color: #818cf8; } .icon-books { color: #34d399; } .icon-students { color: #60a5fa; }
    .icon-borrow { color: #a78bfa; } .icon-return { color: #4ade80; } .icon-borrowings { color: #facc15; } .icon-reports { color: #f87171; }

    /* Content area */
    .content-area { flex: 1; padding: 28px; overflow-y: auto; }
    @keyframes fadeInUp { from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)} }
    .content-area { animation: fadeInUp 0.35s ease-out both; }

    /* Glass card */
    .glass-card { background: rgba(255,255,255,0.70); backdrop-filter: blur(14px) saturate(180%); -webkit-backdrop-filter: blur(14px) saturate(180%); border: 1px solid rgba(255,255,255,0.85); box-shadow: 0 8px 32px rgba(79,70,229,0.08), 0 2px 8px rgba(0,0,0,0.04); border-radius: 16px; }

    /* Alerts */
    .alert { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 18px; border-radius: 12px; font-size: 13.5px; margin-bottom: 20px; animation: fadeInUp 0.3s ease; backdrop-filter: blur(8px); }
    .alert-success { background: rgba(240,253,244,0.88); border: 1px solid rgba(187,247,208,0.85); color: #15803d; }
    .alert-error   { background: rgba(254,242,242,0.88); border: 1px solid rgba(252,165,165,0.85); color: #b91c1c; }
    .alert-content { display: flex; align-items: center; gap: 10px; }
    .alert-close { background: none; border: none; font-size: 18px; color: currentColor; cursor: pointer; opacity: 0.6; line-height: 1; }
    .alert-close:hover { opacity: 1; }

    /* Page header */
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
    .page-title { font-size: 22px; font-weight: 800; color: #1e293b; display: flex; align-items: center; gap: 8px; }
    .page-subtitle { font-size: 13px; color: #64748b; margin-top: 4px; }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 18px; border-radius: 10px; font-size: 13.5px; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.2s ease; border: none; }
    .btn-primary { background: linear-gradient(135deg,#6366f1,#4f46e5); color: #fff; box-shadow: 0 4px 14px rgba(79,70,229,0.30); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(79,70,229,0.45); }
    .btn-outline-primary { background: rgba(255,255,255,0.60); color: var(--primary); border: 1.5px solid var(--primary); }
    .btn-outline-primary:hover { background: rgba(79,70,229,0.08); transform: translateY(-1px); }

    /* KPI Row */
    .kpi-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 22px; }
    .kpi-card { padding: 16px 18px; display: flex; align-items: center; gap: 14px; transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(79,70,229,0.14); }
    .kpi-icon-wrapper { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; }
    .kpi-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; display: block; margin-bottom: 2px; }
    .kpi-value { font-size: 22px; font-weight: 800; color: #1e293b; display: block; }

    /* Filter card */
    .filter-card { padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .search-form { display: flex; align-items: center; gap: 10px; flex: 1; flex-wrap: wrap; }
    .search-input-group { position: relative; flex: 1; min-width: 200px; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; }
    .input-control { width: 100%; padding: 9px 14px 9px 38px; background: rgba(255,255,255,0.70); border: 1.5px solid rgba(203,213,225,0.80); border-radius: 9px; font-size: 13.5px; color: #334155; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .input-control:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }
    .select-control { padding: 9px 14px; background: rgba(255,255,255,0.70); border: 1.5px solid rgba(203,213,225,0.80); border-radius: 9px; font-size: 13.5px; color: #334155; cursor: pointer; outline: none; }
    .select-control:focus { border-color: #6366f1; }
    .filter-actions { margin-left: auto; }
    .btn-reset { display: flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 8px; border: 1.5px solid #e2e8f0; color: #64748b; font-size: 12.5px; font-weight: 500; text-decoration: none; transition: all 0.2s; background: rgba(255,255,255,0.6); }
    .btn-reset:hover { background: #fff; color: #334155; border-color: #94a3b8; }

    /* Table */
    .table-card { background: rgba(255,255,255,0.70); backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.85); border-radius: 16px; box-shadow: 0 8px 32px rgba(79,70,229,0.08); overflow: hidden; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead tr { background: rgba(79,70,229,0.06); border-bottom: 1px solid rgba(203,213,225,0.7); }
    .data-table th { padding: 12px 18px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; white-space: nowrap; }
    .data-table tbody tr { border-bottom: 1px solid rgba(241,245,249,0.9); transition: background 0.15s; }
    .data-table tbody tr:hover { background: rgba(79,70,229,0.03); }
    .data-table td { padding: 14px 18px; vertical-align: middle; color: #334155; }

    .cell-id { color: #94a3b8; font-size: 12px; font-weight: 500; width: 45px; }
    .student-code { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 13px; color: var(--primary); background: rgba(79,70,229,0.08); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(79,70,229,0.15); display: inline-flex; align-items: center; gap: 4px; }
    .student-name-box { display: flex; align-items: center; gap: 12px; }
    .student-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg,#e0e7ff,#c7d2fe); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; border: 1.5px solid rgba(255,255,255,0.9); box-shadow: 0 2px 6px rgba(79,70,229,0.12); flex-shrink: 0; }
    .student-name { font-weight: 600; color: #1e293b; font-size: 13.5px; }
    .student-sub { font-size: 11.5px; color: #64748b; margin-top: 1px; }
    .class-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; background: rgba(241,245,249,0.9); color: #475569; font-size: 12px; font-weight: 600; border: 1px solid #e2e8f0; }
    .borrow-status-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
    .status-active-borrow { background: rgba(37,99,235,0.1); color: #1d4ed8; border: 1px solid rgba(37,99,235,0.25); }
    .status-none-borrow   { background: rgba(100,116,139,0.1); color: #64748b; border: 1px solid rgba(100,116,139,0.2); }
    .date-text { font-size: 12.5px; color: #64748b; display: flex; align-items: center; gap: 5px; }

    /* Action buttons */
    .action-group { display: flex; align-items: center; gap: 6px; justify-content: center; }
    .btn-action { width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; transition: all 0.2s ease; border: 1.5px solid transparent; background: transparent; }
    .btn-edit   { border-color: rgba(79,70,229,0.35); color: var(--primary); background: rgba(79,70,229,0.05); }
    .btn-edit:hover { background: var(--primary); color: #fff; border-color: var(--primary); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(79,70,229,0.25); }
    .btn-reset-pwd { border-color: rgba(217,119,6,0.35); color: var(--warning); background: rgba(217,119,6,0.05); }
    .btn-reset-pwd:hover { background: var(--warning); color: #fff; border-color: var(--warning); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(217,119,6,0.25); }
    .btn-delete { border-color: rgba(220,38,38,0.35); color: var(--danger); background: rgba(220,38,38,0.05); }
    .btn-delete:hover { background: var(--danger); color: #fff; border-color: var(--danger); transform: translateY(-1px); box-shadow: 0 3px 8px rgba(220,38,38,0.25); }

    /* Table footer */
    .table-footer { padding: 12px 20px; border-top: 1px solid rgba(226,232,240,0.8); display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.5); font-size: 12.5px; color: #64748b; }

    /* Empty state */
    .empty-state { padding: 48px; text-align: center; color: #94a3b8; }
  </style>
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <header class="navbar-admin">
    <a href="/admin" class="nav-brand">
      <div class="brand-icon-box">📚</div>
      <div class="brand-title"><%= libraryName %></div>
    </a>
    <div class="nav-user-area">
      <div class="user-pill">
        <span class="status-dot"></span>
        <span>Thủ thư: <strong><%= user ? user.fullName : 'Admin' %></strong></span>
      </div>
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="btn-logout">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Đăng xuất
        </button>
      </form>
    </div>
  </header>

  <div class="main-body">

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar">
      <a href="/admin" class="nav-item">
        <span class="nav-icon icon-dashboard"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg></span>
        <span>Dashboard</span>
      </a>
      <div class="nav-group-title">QUẢN LÝ</div>
      <a href="/admin/books" class="nav-item">
        <span class="nav-icon icon-books"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 016.5 2H20v20H6.5a2.5 2.5 0 01-2.5-2.5z"/><path d="M6 6h10M6 10h10"/></svg></span>
        <span>Quản lý sách</span>
      </a>
      <a href="/admin/students" class="nav-item active">
        <span class="nav-icon icon-students"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
        <span>Quản lý học sinh</span>
      </a>
      <div class="nav-group-title">NGHIỆP VỤ</div>
      <a href="/admin/borrow" class="nav-item">
        <span class="nav-icon icon-borrow"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg></span>
        <span>Mượn sách</span>
      </a>
      <a href="/admin/return" class="nav-item">
        <span class="nav-icon icon-return"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/></svg></span>
        <span>Trả sách</span>
      </a>
      <a href="/admin/borrowings" class="nav-item">
        <span class="nav-icon icon-borrowings"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><path d="M12 11h4M12 16h4M8 11h.01M8 16h.01"/></svg></span>
        <span>Danh sách mượn</span>
      </a>
      <div class="nav-group-title">BÁO CÁO</div>
      <a href="/admin/reports" class="nav-item">
        <span class="nav-icon icon-reports"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></span>
        <span>Báo cáo thống kê</span>
      </a>
    </aside>

    <!-- ===== CONTENT ===== -->
    <main class="content-area">

      <!-- Flash messages -->
      <% if (success_msg) { %>
      <div class="alert alert-success">
        <div class="alert-content"><span style="font-size:16px;">✅</span><span><%= success_msg %></span></div>
        <button class="alert-close" onclick="this.parentElement.style.display='none'">×</button>
      </div>
      <% } %>
      <% if (error_msg) { %>
      <div class="alert alert-error">
        <div class="alert-content"><span style="font-size:16px;">❌</span><span><%= error_msg %></span></div>
        <button class="alert-close" onclick="this.parentElement.style.display='none'">×</button>
      </div>
      <% } %>

      <!-- Page header -->
      <div class="page-header">
        <div class="header-left">
          <h1 class="page-title">👥 Quản lý học sinh</h1>
          <p class="page-subtitle">Danh sách thẻ bạn đọc, thông tin lớp và trạng thái mượn trả sách trong hệ thống</p>
        </div>
        <a href="/admin/students/add" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          + Thêm học sinh
        </a>
      </div>

      <!-- KPI Strip -->
      <div class="kpi-row">
        <div class="glass-card kpi-card">
          <div class="kpi-icon-wrapper" style="background:linear-gradient(135deg,#60a5fa,#2563eb);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div class="kpi-info">
            <span class="kpi-title">Tổng học sinh</span>
            <span class="kpi-value"><%= students ? students.length : 0 %></span>
          </div>
        </div>
        <div class="glass-card kpi-card">
          <div class="kpi-icon-wrapper" style="background:linear-gradient(135deg,#34d399,#059669);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M6 12.5V16a6 3 0 0012 0v-3.5"/><path d="M12 5v16"/></svg>
          </div>
          <div class="kpi-info">
            <span class="kpi-title">Tổng lớp học</span>
            <span class="kpi-value"><%= students ? [...new Set(students.map(s=>s.class).filter(Boolean))].length : 0 %> Lớp</span>
          </div>
        </div>
        <div class="glass-card kpi-card">
          <div class="kpi-icon-wrapper" style="background:linear-gradient(135deg,#fbbf24,#d97706);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v16"/><path d="M20 19a2 2 0 002-2V5a2 2 0 00-2-2l-4-.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 002 2h4a5 5 0 014 2 5 5 0 014-2z"/></svg>
          </div>
          <div class="kpi-info">
            <span class="kpi-title">Đang mượn sách</span>
            <span class="kpi-value" id="borrowingCount">—</span>
          </div>
        </div>
        <div class="glass-card kpi-card">
          <div class="kpi-icon-wrapper" style="background:linear-gradient(135deg,#818cf8,#4f46e5);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 01-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 011-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 011.52 0C14.51 3.81 17 5 19 5a1 1 0 011 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div class="kpi-info">
            <span class="kpi-title">Tài khoản chuẩn</span>
            <span class="kpi-value">100%</span>
          </div>
        </div>
      </div>

      <!-- Filter -->
      <div class="glass-card filter-card">
        <form action="/admin/students" method="GET" class="search-form">
          <div class="search-input-group">
            <span class="search-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.34-4.34"/></svg></span>
            <input type="text" name="search" class="input-control"
              placeholder="Tìm theo tên hoặc mã học sinh..."
              value="<%= search || '' %>">
          </div>
          <button type="submit" class="btn btn-outline-primary">
            🔍 Tìm
          </button>
        </form>
        <div class="filter-actions">
          <% if (search) { %>
          <a href="/admin/students" class="btn-reset">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Đặt lại
          </a>
          <% } %>
        </div>
      </div>

      <!-- Table -->
      <div class="table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:48px;">#</th>
              <th style="width:130px;">Mã HS</th>
              <th>Họ tên học sinh</th>
              <th style="width:110px;">Lớp</th>
              <th style="width:140px;">Sách đang giữ</th>
              <th style="width:130px;">Ngày tạo</th>
              <th style="width:150px;text-align:center;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (students && students.length > 0) { %>
              <% students.forEach(function(s, idx) { %>
                <%
                  const initials = s.fullName
                    ? s.fullName.split(' ').map(w=>w[0]).slice(-2).join('').toUpperCase()
                    : '?';
                  function fmtD(d){ if(!d)return'—'; return new Date(d).toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}); }
                %>
                <tr>
                  <td class="cell-id"><%= String(idx+1).padStart(2,'0') %></td>
                  <td><span class="student-code"><%= s.studentId %></span></td>
                  <td>
                    <div class="student-name-box">
                      <div class="student-avatar"><%= initials %></div>
                      <div>
                        <div class="student-name"><%= s.fullName %></div>
                        <div class="student-sub"><%= s.studentId %>@hubt.edu.vn</div>
                      </div>
                    </div>
                  </td>
                  <td><span class="class-badge"><%= s.class || '—' %></span></td>
                  <td>
                    <span class="borrow-status-pill status-none-borrow">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v16"/><path d="M20 19a2 2 0 002-2V5a2 2 0 00-2-2l-4-.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 002 2h4a5 5 0 014 2 5 5 0 014-2z"/></svg>
                      Xem lịch sử
                    </span>
                  </td>
                  <td>
                    <span class="date-text">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v3M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
                      <span><%= fmtD(s.createdAt) %></span>
                    </span>
                  </td>
                  <td>
                    <div class="action-group">
                      <!-- Sửa -->
                      <a href="/admin/students/<%= s._id %>/edit" class="btn-action btn-edit" title="Sửa thông tin học sinh">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 21h8"/><path d="M21.174 6.812a1 1 0 00-3.986-3.987L3.842 16.174a2 2 0 00-.5.83l-1.321 4.352a.5.5 0 00.623.622l4.353-1.32a2 2 0 00.83-.497z"/></svg>
                      </a>
                      <!-- Reset mật khẩu -->
                      <form action="/admin/students/<%= s._id %>/reset-password" method="POST" style="display:inline;"
                            onsubmit="return confirm('Reset mật khẩu của <%= s.fullName %> về 123456?');">
                        <button type="submit" class="btn-action btn-reset-pwd" title="Reset mật khẩu về 123456">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.586 17.414A2 2 0 002 18.828V21a1 1 0 001 1h3a1 1 0 001-1v-1a1 1 0 011-1h1a1 1 0 001-1v-1a1 1 0 011-1h.172a2 2 0 001.414-.586l.814-.814a6.5 6.5 0 10-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/></svg>
                        </button>
                      </form>
                      <!-- Xóa -->
                      <form action="/admin/students/<%= s._id %>?_method=DELETE" method="POST" style="display:inline;"
                            onsubmit="return confirm('Xóa học sinh <%= s.fullName %> khỏi hệ thống?');">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="btn-action btn-delete" title="Xóa học sinh">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 11v6M14 11v6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7">
                  <div class="empty-state">
                    <div style="font-size:40px;margin-bottom:12px;">👤</div>
                    <div style="font-size:14px;font-weight:500;"><%= search ? 'Không tìm thấy học sinh phù hợp' : 'Chưa có học sinh nào' %></div>
                    <div style="font-size:12.5px;margin-top:6px;">
                      <% if (search) { %><a href="/admin/students" style="color:#6366f1;">Xóa bộ lọc</a> hoặc <% } %>
                      <a href="/admin/students/add" style="color:#6366f1;">Thêm học sinh mới →</a>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Table footer -->
        <div class="table-footer">
          <span>Tổng cộng <strong><%= students ? students.length : 0 %></strong> học sinh<% if(search){ %> (kết quả tìm kiếm)<% } %></span>
          <span style="font-size:11.5px;color:#94a3b8;">🔑 Mật khẩu mặc định: 123456</span>
        </div>
      </div>

    </main>
  </div>

</body>
</html>