<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thông báo · <%= libraryName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body{background:linear-gradient(135deg,#e8f5e9 0%,#f0fdf4 50%,#e0f2fe 100%);background-attachment:fixed;min-height:100vh;font-family:'Plus Jakarta Sans',sans-serif;}
    .font-mono{font-family:'JetBrains Mono',monospace;}
    .navbar-student{background:rgba(22,163,74,0.88);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.2);box-shadow:0 4px 24px rgba(22,163,74,0.25);position:sticky;top:0;z-index:100;}
    .glass{background:rgba(255,255,255,0.65);backdrop-filter:blur(12px) saturate(180%);-webkit-backdrop-filter:blur(12px) saturate(180%);border:1px solid rgba(255,255,255,0.8);box-shadow:0 8px 32px rgba(79,70,229,0.08),0 2px 8px rgba(0,0,0,0.04);border-radius:16px;}
    .noti-card{transition:all 0.25s cubic-bezier(0.4,0,0.2,1);}
    .noti-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(22,163,74,0.10),0 4px 10px rgba(0,0,0,0.04);}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .animate-fadeInUp{animation:fadeInUp 0.4s ease both;}
    .stagger-1{animation-delay:0.05s} .stagger-2{animation-delay:0.10s} .stagger-3{animation-delay:0.15s} .stagger-4{animation-delay:0.20s} .stagger-5{animation-delay:0.25s}
    .badge-red{background-color:#dc2626;color:#fff;box-shadow:0 2px 8px rgba(220,38,38,0.40);}
    .badge-blue{background-color:#2563eb;color:#fff;box-shadow:0 2px 8px rgba(37,99,235,0.40);}
    .badge-green{background-color:#16a34a;color:#fff;box-shadow:0 2px 8px rgba(22,163,74,0.40);}
    .badge-amber{background-color:#d97706;color:#fff;box-shadow:0 2px 8px rgba(217,119,6,0.40);}
    ::-webkit-scrollbar{width:6px;height:6px;} ::-webkit-scrollbar-track{background:transparent;} ::-webkit-scrollbar-thumb{background:rgba(22,163,74,0.3);border-radius:3px;}
  </style>
</head>
<body class="min-h-screen flex flex-col text-slate-800 antialiased">

  <!-- NAVBAR -->
  <header class="navbar-student w-full h-14 text-white">
    <div class="max-w-[1100px] mx-auto h-full px-4 flex items-center justify-between">
      <div class="flex items-center space-x-7">
        <a href="/student" class="flex items-center space-x-2.5 group no-underline text-white">
          <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center border border-white/30 group-hover:scale-105 transition-transform">
            <span class="text-lg">📚</span>
          </div>
          <span class="font-bold text-[15px] tracking-tight leading-tight"><%= libraryName %></span>
        </a>
        <nav class="hidden md:flex items-center space-x-1.5 text-[13px] font-medium">
          <a href="/student" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors flex items-center space-x-1.5 no-underline">
            <span>🏠</span><span>Trang chủ</span>
          </a>
          <a href="/student/books" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors flex items-center space-x-1.5 no-underline">
            <span>🔍</span><span>Tra cứu sách</span>
          </a>
          <a href="/student/my-borrowings" class="px-3 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors flex items-center space-x-1.5 no-underline">
            <span>🕒</span><span>Lịch sử mượn</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-4">
        <!-- Bell — active (đang ở trang notifications) -->
        <a href="/student/notifications" title="Xem thông báo" class="relative p-2 rounded-xl bg-white/20 text-white border border-white/35 shadow-sm flex items-center justify-center no-underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </a>

        <!-- User info -->
        <div class="flex flex-col text-left justify-start">
          <div class="flex items-center space-x-1.5">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-semibold bg-white/25 border border-white/40 text-emerald-50">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 mr-1 animate-ping"></span>Học sinh
            </span>
            <span class="text-[13px] font-bold text-white drop-shadow-sm"><%= user ? user.fullName : '' %></span>
          </div>
          <div class="flex items-center space-x-1 mt-0.5">
            <span class="font-mono text-[11px] text-emerald-100/90 tracking-wide font-medium"><%= user ? user.studentId : '' %></span>
            <% if (user && user.class) { %><span class="text-[10px] text-emerald-200/80">·</span><span class="text-[11px] text-emerald-100/90 font-medium">Lớp <%= user.class %></span><% } %>
          </div>
        </div>

        <!-- Logout -->
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/25 text-white text-[12px] font-medium transition-all flex items-center space-x-1 shadow-sm cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span class="hidden sm:inline">Đăng xuất</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- CONTENT -->
  <main class="flex-grow max-w-[1100px] w-full mx-auto px-4 py-7">

    <%
      const total     = notifications ? notifications.length : 0;
      // sau khi vào trang, route đã mark all đã đọc — nhưng tính theo dữ liệu trả về
      const cntUnread = notifications ? notifications.filter(n=>!n.isRead).length : 0;
      const cntRead   = total - cntUnread;
      function fmtDT(d){
        if(!d) return '—';
        return new Date(d).toLocaleString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
      }
      // type config
      const typeMap = {
        overdue : { borderColor:'#dc2626', bgColor:'rgba(220,38,38,0.15)',  icon:'⚠️', labelCls:'text-red-600 bg-red-50 border-red-200/80',   label:'Cảnh báo quá hạn',      titleCls:'text-red-600',    linkCls:'text-red-600 hover:text-red-700',   linkText:'Xem chi tiết phiếu mượn' },
        reminder: { borderColor:'#d97706', bgColor:'rgba(217,119,6,0.15)',  icon:'⏰', labelCls:'text-amber-700 bg-amber-50 border-amber-200/80',label:'Nhắc hạn trả sách',    titleCls:'text-amber-700',  linkCls:'text-amber-700 hover:text-amber-800',linkText:'Kiểm tra phiếu mượn' },
        borrow  : { borderColor:'#4f46e5', bgColor:'rgba(99,102,241,0.15)', icon:'📚', labelCls:'text-indigo-700 bg-indigo-50 border-indigo-200/80',label:'Mượn sách thành công',titleCls:'text-indigo-700', linkCls:'text-indigo-700 hover:text-indigo-800',linkText:'Xem lịch sử mượn' },
        return  : { borderColor:'#16a34a', bgColor:'rgba(22,163,74,0.15)',  icon:'✅', labelCls:'text-emerald-700 bg-emerald-50/70 border-emerald-200/60',label:'Đã trả sách',    titleCls:'text-slate-800',  linkCls:'text-slate-500 hover:text-emerald-700',linkText:'Xem lịch sử' },
        general : { borderColor:'#64748b', bgColor:'rgba(100,116,139,0.15)',icon:'📢', labelCls:'text-slate-600 bg-slate-50 border-slate-200/80',   label:'Thông báo',           titleCls:'text-slate-800',  linkCls:'text-slate-500 hover:text-slate-700',  linkText:'Xem lịch sử' },
      };
    %>

    <!-- Page header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-400 text-white flex items-center justify-center shadow-md shadow-amber-500/20 text-xl">🔔</div>
          <div>
            <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
              Thông Báo Của Bạn
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300/60">
                Tài khoản: <%= user ? user.studentId : '' %>
              </span>
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">Theo dõi biến động mượn trả sách, nhắc hạn và các thông báo từ thư viện trường</p>
          </div>
        </div>
      </div>

      <!-- Filter tabs -->
      <div class="flex items-center flex-wrap gap-2.5">
        <span class="text-xs text-slate-500 hidden sm:inline">Lọc xem:</span>
        <div class="inline-flex p-1 rounded-xl bg-white/70 backdrop-blur-md border border-white/80 shadow-sm text-xs font-semibold">
          <button onclick="filterNotis('all')" id="tab-all" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow-sm transition-all">Tất cả (<%= total %>)</button>
          <button onclick="filterNotis('unread')" id="tab-unread" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition-all flex items-center gap-1">
            <span>Chưa đọc</span><span class="w-2 h-2 rounded-full bg-red-500 inline-block"></span><span class="text-[10px] text-red-600 font-bold">(<%= cntUnread %>)</span>
          </button>
          <button onclick="filterNotis('read')" id="tab-read" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition-all">Đã đọc (<%= cntRead %>)</button>
        </div>
        <button onclick="markAllRead()" class="px-3.5 py-2 rounded-xl bg-white/80 hover:bg-white text-slate-700 text-xs font-semibold border border-slate-200 shadow-sm hover:shadow transition-all flex items-center gap-1.5 active:scale-95">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Đánh dấu đã đọc tất cả</span>
        </button>
      </div>
    </div>

    <!-- Info note -->
    <div class="mb-6 p-4 rounded-xl bg-emerald-50/70 border border-emerald-200/80 backdrop-blur-sm flex items-start space-x-3 text-xs text-emerald-900 shadow-sm animate-fadeInUp">
      <div class="text-base flex-shrink-0 mt-0.5">ℹ️</div>
      <div class="leading-relaxed">
        <p class="font-semibold text-emerald-950">Quy định thông báo tự động:</p>
        <p class="text-emerald-800/90 mt-0.5">
          Hệ thống sẽ gửi thông báo tự động khi bạn <strong>mượn sách mới</strong>, nhắc nhở <strong>sắp đến hạn trả (trước 1 ngày)</strong>, cảnh báo khi <strong>quá hạn</strong> hoặc xác nhận <strong>trả sách hoàn tất</strong>. Khi mở trang thông báo, hệ thống sẽ tự động cập nhật trạng thái các tin nhắn mới.
        </p>
      </div>
    </div>

    <!-- Notification list -->
    <% if (notifications && notifications.length > 0) { %>
    <div class="space-y-3.5" id="noti-list">
      <% notifications.forEach(function(n, idx) { %>
        <%
          const cfg     = typeMap[n.type] || typeMap.general;
          const isUnread= !n.isRead;
          const stagger = ['stagger-1','stagger-2','stagger-3','stagger-4','stagger-5'][idx % 5];
        %>
        <div data-read="<%= isUnread ? 'unread' : 'read' %>"
             class="noti-card animate-fadeInUp <%= stagger %> p-4 sm:p-5 rounded-2xl backdrop-blur-md flex items-start gap-4 transition-all
               <%= isUnread
                 ? 'bg-white/75 border border-white/80 shadow-sm'
                 : 'bg-white/45 border border-white/60 shadow-xs' %>"
             style="<%= isUnread ? 'border-left: 4px solid ' + cfg.borderColor + ';' : '' %>">

          <!-- Icon -->
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm <%= isUnread ? '' : 'opacity-85' %>"
               style="background-color:<%= cfg.bgColor %>;">
            <span class="text-xl"><%= cfg.icon %></span>
          </div>

          <!-- Body -->
          <div class="flex-grow min-w-0">
            <div class="flex items-start justify-between gap-3">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="text-[11px] font-bold uppercase tracking-wider <%= cfg.labelCls %> border px-2 py-0.5 rounded-md">
                    <%= cfg.label %>
                  </span>
                  <span class="text-xs text-<%= isUnread ? 'slate-400' : 'slate-300' %>">•</span>
                </div>
                <h3 class="text-sm sm:text-[15px] <%= isUnread ? 'font-bold text-slate-900' : 'font-semibold text-slate-700' %> mt-1">
                  <span class="<%= cfg.titleCls %><%= isUnread ? ' font-extrabold' : ' font-bold' %>">
                    <%= n.message %>
                  </span>
                </h3>
              </div>

              <!-- Badge: Mới (chưa đọc) hoặc Đã đọc tick -->
              <% if (isUnread) { %>
              <div class="flex-shrink-0">
                <span class="badge-red text-[11px] font-semibold px-2.5 py-0.5 rounded-full">Mới</span>
              </div>
              <% } else { %>
              <div class="flex-shrink-0 text-slate-400 text-xs flex items-center gap-1 font-medium">
                <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Đã đọc</span>
              </div>
              <% } %>
            </div>

            <!-- Footer: time + link -->
            <div class="mt-3 pt-2.5 border-t <%= isUnread ? 'border-slate-100' : 'border-slate-100/80' %> flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center space-x-2 <%= isUnread ? 'text-slate-500' : 'text-slate-400' %> font-mono text-[11px]">
                <svg class="w-3.5 h-3.5 <%= isUnread ? 'text-slate-400' : 'text-slate-300' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span><%= fmtDT(n.createdAt) %></span>
              </div>
              <a href="/student/my-borrowings" class="inline-flex items-center gap-1 font-semibold no-underline <%= cfg.linkCls %>">
                <span><%= cfg.linkText %></span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination footer -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 pt-4 border-t border-slate-200/80">
      <div class="flex items-center space-x-2">
        <span>Hiển thị <strong><%= total %> / <%= total %></strong> thông báo</span>
        <span>•</span>
        <span class="text-emerald-700 font-medium">Tự động cập nhật khi có thông báo mới</span>
      </div>
      <div class="flex items-center space-x-1.5">
        <button class="px-3 py-1.5 rounded-lg bg-white/70 border border-slate-200 text-slate-400 cursor-not-allowed text-xs font-medium">← Trang trước</button>
        <span class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-bold text-xs shadow-sm">1</span>
        <button class="px-3 py-1.5 rounded-lg bg-white/70 border border-slate-200 text-slate-400 cursor-not-allowed text-xs font-medium">Trang sau →</button>
      </div>
    </div>

    <% } else { %>
    <!-- Empty state -->
    <div class="glass p-20 text-center animate-fadeInUp">
      <div class="text-5xl mb-4">🔔</div>
      <h3 class="text-lg font-semibold text-slate-700 mb-1">Không có thông báo nào</h3>
      <p class="text-sm text-slate-500">Thông báo sẽ xuất hiện khi bạn mượn hoặc trả sách</p>
      <a href="/student" class="mt-4 inline-block text-sm text-emerald-700 font-semibold no-underline">→ Về trang chủ</a>
    </div>
    <% } %>

  </main>

  <!-- Footer -->
  <footer class="w-full mt-auto py-5 border-t border-emerald-900/10 text-xs text-slate-500">
    <div class="max-w-[1100px] mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <span class="font-semibold text-slate-600"><%= libraryName %></span>
      <p class="text-slate-500">Giờ mở cửa thư viện: Thứ 2 – Thứ 7 (07:30 – 17:00)</p>
    </div>
  </footer>

  <script>
    // Client-side filter tabs (không cần reload)
    function filterNotis(type) {
      const items = document.querySelectorAll('#noti-list > [data-read]');
      items.forEach(el => {
        const isUnread = el.dataset.read === 'unread';
        if (type === 'all') el.style.display = '';
        else if (type === 'unread') el.style.display = isUnread ? '' : 'none';
        else el.style.display = !isUnread ? '' : 'none';
      });
      // Update tab styles
      const tabs = { all: 'tab-all', unread: 'tab-unread', read: 'tab-read' };
      Object.entries(tabs).forEach(([key, id]) => {
        const el = document.getElementById(id);
        if (key === type) {
          el.className = 'px-3 py-1.5 rounded-lg bg-emerald-600 text-white shadow-sm transition-all flex items-center gap-1';
        } else {
          el.className = 'px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition-all flex items-center gap-1';
        }
      });
    }

    function markAllRead() {
      // Visual only — backend đã mark all đã đọc khi load trang (route /notifications)
      document.querySelectorAll('#noti-list > [data-read="unread"]').forEach(el => {
        el.dataset.read = 'read';
        // Xóa border-left đỏ/amber/indigo
        el.style.borderLeft = '';
        el.classList.replace('bg-white/75', 'bg-white/45');
        el.classList.replace('border-white/80', 'border-white/60');
        // Badge "Mới" → "Đã đọc"
        const badge = el.querySelector('.badge-red');
        if (badge) {
          badge.outerHTML = '<div class="flex-shrink-0 text-slate-400 text-xs flex items-center gap-1 font-medium"><svg class=\'w-4 h-4 text-emerald-500\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M5 13l4 4L19 7\'/></svg><span>Đã đọc</span></div>';
        }
      });
    }
  </script>

</body>
</html>