<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tra cứu sách · <%= libraryName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;font-family:'Plus Jakarta Sans',sans-serif;}
    body{background:linear-gradient(135deg,#e8f5e9 0%,#f0fdf4 50%,#e0f2fe 100%);background-attachment:fixed;min-height:100vh;color:#1e293b;}
    .navbar-student{background:rgba(22,163,74,0.90);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.2);box-shadow:0 4px 24px rgba(22,163,74,0.25);position:sticky;top:0;z-index:100;}
    .glass-card{background:rgba(255,255,255,0.70);backdrop-filter:blur(16px) saturate(180%);-webkit-backdrop-filter:blur(16px) saturate(180%);border:1px solid rgba(255,255,255,0.85);box-shadow:0 8px 32px rgba(79,70,229,0.08),0 2px 8px rgba(0,0,0,0.04);border-radius:16px;}
    .book-card{background:rgba(255,255,255,0.75);backdrop-filter:blur(12px) saturate(180%);-webkit-backdrop-filter:blur(12px) saturate(180%);border:1px solid rgba(255,255,255,0.85);box-shadow:0 4px 20px rgba(0,0,0,0.04);border-radius:16px;transition:all 0.25s cubic-bezier(0.16,1,0.3,1);display:flex;flex-direction:column;justify-content:space-between;}
    .book-card:hover{transform:translateY(-4px);box-shadow:0 16px 32px rgba(22,163,74,0.12),0 4px 12px rgba(0,0,0,0.06);border-color:rgba(34,197,94,0.4);}
    .input-control{background:rgba(255,255,255,0.85);border:1.5px solid rgba(226,232,240,0.9);border-radius:10px;transition:all 0.2s ease;}
    .input-control:focus{background:rgba(255,255,255,0.98);border-color:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,0.15);outline:none;}
    .badge-pill{border-radius:9999px;padding:3px 10px;font-size:11px;font-weight:600;display:inline-flex;align-items:center;gap:4px;}
    .badge-gray{background:#64748b;color:#fff;}
    .badge-green{background:#16a34a;color:#fff;box-shadow:0 2px 8px rgba(22,163,74,0.35);}
    .badge-red{background:#dc2626;color:#fff;box-shadow:0 2px 8px rgba(220,38,38,0.35);}
    .btn-green-primary{background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 4px 12px rgba(22,163,74,0.30);border:none;color:#fff;font-weight:600;border-radius:10px;transition:all 0.2s ease;}
    .btn-green-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(22,163,74,0.45);}
    .page-content{animation:fadeInUp 0.4s ease both;}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
    .filter-chip{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:600;transition:all 0.2s ease;cursor:pointer;border:1px solid rgba(0,0,0,0.06);text-decoration:none;}
    .filter-chip.active{background:#16a34a;color:#fff;box-shadow:0 2px 8px rgba(22,163,74,0.3);}
    .filter-chip:not(.active){background:rgba(255,255,255,0.7);color:#475569;}
    .filter-chip:not(.active):hover{background:rgba(255,255,255,0.95);color:#16a34a;}
    ::-webkit-scrollbar{width:6px;height:6px;} ::-webkit-scrollbar-track{background:transparent;} ::-webkit-scrollbar-thumb{background:rgba(22,163,74,0.3);border-radius:3px;}
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- NAVBAR -->
  <header class="navbar-student w-full h-14 px-6 flex items-center justify-between">
    <div class="flex items-center space-x-8">
      <a href="/student" class="flex items-center space-x-2.5 text-white font-bold text-base hover:opacity-90 transition no-underline">
        <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center border border-white/30 text-lg shadow-sm">📚</div>
        <span class="tracking-tight text-sm leading-tight"><%= libraryName %></span>
      </a>
      <nav class="hidden md:flex items-center space-x-1 text-sm font-medium">
        <a href="/student" class="px-3.5 py-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition no-underline">Trang chủ</a>
        <!-- Active: Tra cứu sách -->
        <a href="/student/books" class="px-3.5 py-1.5 rounded-lg bg-white/25 text-white font-semibold border border-white/20 flex items-center gap-1.5 no-underline">
          <span>🔍</span> Tra cứu sách
        </a>
        <a href="/student/my-borrowings" class="px-3.5 py-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition no-underline">Lịch sử mượn</a>
      </nav>
    </div>
    <div class="flex items-center space-x-4">
      <!-- Bell -->
      <a href="/student/notifications" title="Thông báo" class="relative p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white transition border border-white/10 no-underline">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      </a>
      <!-- User info -->
      <div class="flex items-center space-x-2.5 pl-2 border-l border-white/20">
        <div class="hidden sm:block text-left leading-tight">
          <div class="flex items-center gap-1.5">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-white/20 text-white border border-white/30">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>Học sinh
            </span>
            <span class="text-xs font-semibold text-white"><%= user ? user.fullName : '' %></span>
          </div>
          <div class="text-[11px] font-mono text-emerald-100 opacity-90 mt-0.5"><%= user ? user.studentId : '' %><% if (user && user.class) { %> · Lớp <%= user.class %><% } %></div>
        </div>
      </div>
      <!-- Logout -->
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" title="Đăng xuất" class="p-2 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 transition-all text-white hover:scale-105 flex items-center space-x-1 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span class="hidden lg:inline text-xs font-medium">Đăng xuất</span>
        </button>
      </form>
    </div>
  </header>

  <!-- CONTENT -->
  <main class="flex-1 w-full max-w-[1100px] mx-auto px-4 sm:px-6 py-6 page-content">

    <!-- Page header -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/student" class="hover:text-green-700 transition no-underline text-slate-500">Học sinh</a>
          <span>/</span>
          <span class="text-green-700 font-semibold">Tra cứu sách</span>
        </div>
        <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight flex items-center gap-2">
          <span>📚</span> Tra Cứu Kho Sách Thư Viện
        </h1>
        <p class="text-xs text-slate-500 mt-1">Tìm kiếm, lọc sách theo thể loại và kiểm tra số lượng bản có sẵn trong kho trực tiếp</p>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto bg-white/60 backdrop-blur-md border border-white/80 px-3.5 py-1.5 rounded-full shadow-sm">
        <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-ping"></span>
        <span class="text-xs font-semibold text-slate-700">Tổng kho: <span class="text-green-700 font-bold font-mono"><%= books ? books.length : 0 %></span> đầu sách</span>
      </div>
    </div>

    <!-- Flash messages -->
    <% if (success_msg) { %>
    <div class="mb-5 bg-emerald-50 border border-emerald-300 text-emerald-800 rounded-xl px-4 py-3 text-sm flex items-center justify-between">
      <div class="flex items-center gap-2"><span>✅</span><span><%= success_msg %></span></div>
      <button onclick="this.parentElement.remove()" class="text-emerald-600 font-bold">✕</button>
    </div>
    <% } %>
    <% if (error_msg) { %>
    <div class="mb-5 bg-red-50 border border-red-300 text-red-800 rounded-xl px-4 py-3 text-sm flex items-center justify-between">
      <div class="flex items-center gap-2"><span>❌</span><span><%= error_msg %></span></div>
      <button onclick="this.parentElement.remove()" class="text-red-600 font-bold">✕</button>
    </div>
    <% } %>

    <!-- Vùng 1: Form tìm kiếm + bộ lọc -->
    <section class="glass-card p-5 sm:p-6 mb-7">
      <form action="/student/books" method="GET" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-center">
          <!-- Search input -->
          <div class="md:col-span-7 relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </span>
            <input type="text" name="search" value="<%= search || '' %>"
              placeholder="Tìm theo tên sách, tác giả hoặc nhà xuất bản..."
              class="w-full pl-10 pr-4 py-2.5 input-control text-sm text-slate-800 placeholder-slate-400 focus:outline-none">
          </div>
          <!-- Category dropdown -->
          <div class="md:col-span-3 relative">
            <select name="category" class="w-full px-3.5 py-2.5 input-control text-sm text-slate-700 bg-white cursor-pointer appearance-none pr-8 focus:outline-none">
              <option value="">Tất cả thể loại</option>
              <option value="Sách giáo khoa" <%= category==='Sách giáo khoa' ? 'selected' : '' %>>Sách giáo khoa</option>
              <option value="Sách tham khảo" <%= category==='Sách tham khảo' ? 'selected' : '' %>>Sách tham khảo</option>
              <option value="Công nghệ thông tin" <%= category==='Công nghệ thông tin' ? 'selected' : '' %>>Công nghệ thông tin</option>
              <option value="Kỹ năng sống" <%= category==='Kỹ năng sống' ? 'selected' : '' %>>Kỹ năng sống</option>
              <option value="Khoa học tự nhiên" <%= category==='Khoa học tự nhiên' ? 'selected' : '' %>>Khoa học tự nhiên</option>
              <option value="Lịch sử - Xã hội" <%= category==='Lịch sử - Xã hội' ? 'selected' : '' %>>Lịch sử - Xã hội</option>
              <option value="Văn học" <%= category==='Văn học' ? 'selected' : '' %>>Văn học</option>
              <option value="Kỹ thuật phần mềm" <%= category==='Kỹ thuật phần mềm' ? 'selected' : '' %>>Kỹ thuật phần mềm</option>
            </select>
            <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </div>
          <!-- Submit button -->
          <div class="md:col-span-2">
            <button type="submit" class="w-full py-2.5 px-4 btn-green-primary flex items-center justify-center gap-2 text-sm cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <span>Tìm kiếm</span>
            </button>
          </div>
        </div>

        <!-- Quick filter chips -->
        <div class="pt-2 border-t border-slate-200/60 flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-500 font-medium mr-1">Lọc nhanh:</span>
          <a href="/student/books" class="filter-chip <%= !category && !search ? 'active' : '' %>">Tất cả</a>
          <a href="/student/books?category=Sách+giáo+khoa" class="filter-chip <%= category==='Sách giáo khoa' ? 'active' : '' %>">Sách giáo khoa</a>
          <a href="/student/books?category=Công+nghệ+thông+tin" class="filter-chip <%= category==='Công nghệ thông tin' ? 'active' : '' %>">Công nghệ &amp; Lập trình</a>
          <a href="/student/books?category=Kỹ+năng+sống" class="filter-chip <%= category==='Kỹ năng sống' ? 'active' : '' %>">Kỹ năng sống</a>
          <a href="/student/books?category=Khoa+học+tự+nhiên" class="filter-chip <%= category==='Khoa học tự nhiên' ? 'active' : '' %>">Khoa học tự nhiên</a>
          <a href="/student/books?category=Văn+học" class="filter-chip <%= category==='Văn học' ? 'active' : '' %>">Văn học &amp; Lịch sử</a>
        </div>
      </form>
    </section>

    <!-- Result count + note -->
    <div class="mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-1">
      <div class="text-xs text-slate-600 font-medium">
        <% if (search || category) { %>
        Kết quả tìm kiếm: <span class="font-bold text-slate-800"><%= books ? books.length : 0 %></span> đầu sách
        <% if (search) { %><span class="text-slate-400"> · từ khóa "<span class="text-green-700"><%= search %></span>"</span><% } %>
        <% if (category) { %><span class="text-slate-400"> · thể loại "<span class="text-green-700"><%= category %></span>"</span><% } %>
        <% } else { %>
        Hiển thị <span class="font-bold text-slate-800"><%= books ? books.length : 0 %></span> đầu sách trong kho
        <% } %>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100/70 border border-emerald-200 text-emerald-800 text-[11px] font-medium">
        <span>ℹ️</span> <span>Học sinh chọn sách và tới quầy thủ thư để đăng ký mượn</span>
      </div>
    </div>

    <!-- Vùng 2: Book card grid -->
    <% if (books && books.length > 0) { %>
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
      <% books.forEach(function(book) { %>
        <%
          const hasStock = book.availableCopies > 0;
          // Icon emoji by category
          const catIcons = {
            'Kỹ năng sống':'📖','Công nghệ thông tin':'💻','Kỹ thuật phần mềm':'⚙️',
            'Sách giáo khoa':'📐','Lịch sử - Xã hội':'🏛️','Sách tham khảo':'🧪',
            'Văn học':'✍️','Khoa học tự nhiên':'🔬'
          };
          const catColors = {
            'Kỹ năng sống':'bg-amber-100 text-amber-700','Công nghệ thông tin':'bg-indigo-100 text-indigo-700',
            'Kỹ thuật phần mềm':'bg-red-100 text-red-700','Sách giáo khoa':'bg-blue-100 text-blue-700',
            'Lịch sử - Xã hội':'bg-purple-100 text-purple-700','Sách tham khảo':'bg-emerald-100 text-emerald-700',
            'Văn học':'bg-pink-100 text-pink-700','Khoa học tự nhiên':'bg-cyan-100 text-cyan-700'
          };
          const icon  = catIcons[book.category]  || '📚';
          const color = catColors[book.category] || 'bg-slate-100 text-slate-700';
        %>
        <article class="book-card p-5">
          <div>
            <!-- Card header: category badge + icon -->
            <div class="flex items-start justify-between gap-2 mb-3">
              <span class="badge-pill badge-gray"><%= book.category || 'Khác' %></span>
              <div class="w-8 h-8 rounded-lg <%= color %> flex items-center justify-center text-sm shadow-inner flex-shrink-0"><%= icon %></div>
            </div>
            <!-- Title -->
            <h2 class="text-base font-semibold text-slate-900 leading-snug line-clamp-2 hover:text-green-700 transition"><%= book.title %></h2>
            <!-- Author -->
            <div class="mt-2 text-xs text-slate-600 flex items-center gap-1.5">
              <span class="text-slate-400">👤 Tác giả:</span>
              <span class="font-medium text-slate-700"><%= book.author || '—' %></span>
            </div>
            <!-- Publisher -->
            <% if (book.publisher) { %>
            <div class="mt-1 text-xs text-slate-500 flex items-center gap-1.5">
              <span class="text-slate-400">🏢 NXB:</span>
              <span><%= book.publisher %></span>
            </div>
            <% } %>
            <!-- Description -->
            <% if (book.description) { %>
            <p class="mt-2.5 text-[12px] text-slate-500 line-clamp-2 leading-relaxed"><%= book.description %></p>
            <% } %>
          </div>

          <!-- Card footer: total + availability badge -->
          <div class="mt-4 pt-3.5 border-t border-slate-200/80 flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">
              Tổng: <span class="font-semibold text-slate-700 font-mono"><%= book.totalCopies || 0 %></span> bản
            </span>
            <% if (hasStock) { %>
            <span class="badge-pill badge-green">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              Còn <%= book.availableCopies %> bản
            </span>
            <% } else { %>
            <span class="badge-pill badge-red">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
              Hết sách
            </span>
            <% } %>
          </div>
        </article>
      <% }); %>
    </section>
    <% } else { %>
    <!-- Empty state -->
    <div class="glass-card p-16 text-center mb-8">
      <div class="text-5xl mb-4">🔍</div>
      <h3 class="text-lg font-semibold text-slate-700 mb-1">
        <%= search || category ? 'Không tìm thấy sách phù hợp' : 'Kho sách đang trống' %>
      </h3>
      <p class="text-sm text-slate-500 mb-4">
        <%= search || category ? 'Thử tìm với từ khóa khác hoặc xóa bộ lọc' : 'Hãy quay lại sau' %>
      </p>
      <% if (search || category) { %>
      <a href="/student/books" class="inline-flex items-center gap-2 px-4 py-2 btn-green-primary text-sm rounded-lg no-underline">
        <span>Xem tất cả sách</span>
      </a>
      <% } %>
    </div>
    <% } %>

    <!-- Footer note -->
    <footer class="pb-6 flex justify-end text-xs text-slate-500">
      <div>Giờ mở cửa thư viện: Thứ 2 – Thứ 7 (07:30 – 17:00)</div>
    </footer>

  </main>
</body>
</html>