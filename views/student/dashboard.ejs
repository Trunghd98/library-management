<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trang chủ · <%= libraryName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background:linear-gradient(135deg,#e8f5e9 0%,#f0fdf4 50%,#e0f2fe 100%); background-attachment:fixed; min-height:100vh; font-family:'Plus Jakarta Sans',sans-serif; color:#334155; }
    .navbar-student { background:rgba(22,163,74,0.90); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border-bottom:1px solid rgba(255,255,255,0.2); box-shadow:0 4px 24px rgba(22,163,74,0.25); position:sticky; top:0; z-index:100; }
    .glass-card { background:rgba(255,255,255,0.70); backdrop-filter:blur(14px) saturate(180%); -webkit-backdrop-filter:blur(14px) saturate(180%); border:1px solid rgba(255,255,255,0.85); box-shadow:0 8px 32px rgba(22,163,74,0.08),0 2px 8px rgba(0,0,0,0.04); border-radius:16px; }
    .card-hover { transition:all 0.3s cubic-bezier(0.4,0,0.2,1); }
    .card-hover:hover { transform:translateY(-4px); box-shadow:0 16px 36px rgba(22,163,74,0.14),0 4px 12px rgba(0,0,0,0.06); }
    @keyframes fadeInUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .fade-in-up{animation:fadeInUp 0.4s ease both;}
    .stagger-1{animation-delay:0.05s} .stagger-2{animation-delay:0.12s} .stagger-3{animation-delay:0.18s} .stagger-4{animation-delay:0.24s}
    ::-webkit-scrollbar{width:6px;} ::-webkit-scrollbar-track{background:transparent;} ::-webkit-scrollbar-thumb{background:rgba(22,163,74,0.3);border-radius:3px;}
    .badge-blue{background-color:#2563eb;color:#fff;box-shadow:0 2px 8px rgba(37,99,235,0.35);}
    .badge-amber{background-color:#d97706;color:#fff;box-shadow:0 2px 8px rgba(217,119,6,0.35);}
    .badge-red{background-color:#dc2626;color:#fff;box-shadow:0 2px 8px rgba(220,38,38,0.35);}
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- NAVBAR -->
  <header class="navbar-student w-full h-14 text-white">
    <div class="max-w-[1140px] mx-auto h-full px-4 sm:px-6 flex items-center justify-between">

      <!-- Left: Logo + Nav -->
      <div class="flex items-center space-x-8">
        <a href="/student" class="flex items-center space-x-2.5 group no-underline text-white">
          <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center border border-white/30 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <span class="font-bold text-base tracking-tight"><%= libraryName %></span>
        </a>
        <nav class="hidden md:flex items-center space-x-1 text-sm font-medium">
          <!-- Active: Trang chủ -->
          <a href="/student" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-lg bg-white/20 text-white shadow-sm border border-white/30 font-semibold no-underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Trang chủ</span>
          </a>
          <a href="/student/books" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors no-underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span>Tra cứu sách</span>
          </a>
          <a href="/student/my-borrowings" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-lg text-white/85 hover:text-white hover:bg-white/10 transition-colors no-underline">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Lịch sử mượn</span>
          </a>
        </nav>
      </div>

      <!-- Right: Bell + user + logout -->
      <div class="flex items-center space-x-3.5 sm:space-x-4">
        <!-- Bell icon -->
        <a href="/student/notifications" title="Thông báo" class="relative p-2 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 transition-all text-white hover:scale-105 no-underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <% if (unreadCount > 0) { %>
          <span class="absolute -top-1 -right-1 flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[11px] font-bold text-white bg-red-600 rounded-full ring-2 ring-emerald-600 shadow-md animate-pulse">
            <%= unreadCount > 9 ? '9+' : unreadCount %>
          </span>
          <% } %>
        </a>

        <!-- User info -->
        <div class="flex items-center space-x-2.5 pl-2 border-l border-white/20">
          <div class="hidden sm:block text-left leading-tight">
            <div class="flex items-center gap-1.5">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-white/20 text-white border border-white/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>Học sinh
              </span>
              <span class="text-xs font-semibold text-white drop-shadow-sm"><%= user ? user.fullName : '' %></span>
            </div>
            <div class="text-[11px] font-mono text-emerald-100 opacity-90 mt-0.5">
              <%= user ? user.studentId : '' %><% if (user && user.class) { %> · Lớp <%= user.class %><% } %>
            </div>
          </div>
        </div>

        <!-- Logout -->
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" title="Đăng xuất" class="p-2 rounded-xl bg-white/15 hover:bg-white/25 border border-white/20 transition-all text-white hover:scale-105 flex items-center space-x-1 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span class="hidden lg:inline text-xs font-medium">Đăng xuất</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- CONTENT -->
  <main class="flex-1 w-full max-w-[1100px] mx-auto px-4 sm:px-6 py-7 space-y-6">

    <!-- Flash messages -->
    <% if (success_msg) { %>
    <div class="fade-in-up bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 rounded-xl px-4 py-3 text-sm flex items-center justify-between backdrop-blur-md shadow-sm">
      <div class="flex items-center space-x-2.5"><span class="text-lg">✅</span><span><%= success_msg %></span></div>
      <button onclick="this.parentElement.remove()" class="text-emerald-700 font-bold p-1">✕</button>
    </div>
    <% } %>
    <% if (error_msg) { %>
    <div class="fade-in-up bg-red-50/80 border border-red-300/50 text-red-800 rounded-xl px-4 py-3 text-sm flex items-center justify-between backdrop-blur-md shadow-sm">
      <div class="flex items-center space-x-2.5"><span class="text-lg">❌</span><span><%= error_msg %></span></div>
      <button onclick="this.parentElement.remove()" class="text-red-700 font-bold p-1">✕</button>
    </div>
    <% } %>

    <!-- Welcome banner -->
    <% if (!success_msg && !error_msg) { %>
    <div class="fade-in-up bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 rounded-xl px-4 py-3 text-sm flex items-center justify-between backdrop-blur-md shadow-sm">
      <div class="flex items-center space-x-2.5">
        <span class="text-lg">👋</span>
        <span>Chào mừng bạn quay lại hệ thống thư viện trực tuyến! Đừng quên kiểm tra hạn trả sách để tránh phí phạt trễ hạn nhé.</span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold p-1">✕</button>
    </div>
    <% } %>

    <!-- Vùng 1: Lời chào + thông tin HS -->
    <div class="fade-in-up stagger-1 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-1">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-slate-800 tracking-tight flex items-center gap-2">
          <span>Xin chào, <%= user ? user.fullName : 'Bạn' %>!</span>
          <span class="inline-block animate-bounce">👋</span>
        </h1>
        <div class="flex items-center gap-2 mt-1 text-sm text-slate-600">
          <span>Mã học sinh:</span>
          <span class="font-mono font-semibold text-[#4f46e5] bg-indigo-50 px-2 py-0.5 rounded border border-indigo-100 text-xs"><%= user ? user.studentId : '' %></span>
          <% if (user && user.class) { %>
          <span class="text-slate-300">•</span>
          <span class="text-xs text-slate-500">Lớp: <strong class="text-slate-700 font-medium"><%= user.class %></strong></span>
          <% } %>
        </div>
      </div>
      <div class="flex items-center self-start sm:self-auto gap-2 bg-white/60 border border-white/80 px-3 py-1.5 rounded-xl shadow-xs backdrop-blur-md">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-xs font-medium text-slate-700">Tài khoản Thư viện: <strong class="text-emerald-700">Hợp lệ</strong></span>
      </div>
    </div>

    <!-- Vùng 2: 2 thẻ thông tin nhanh -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 fade-in-up stagger-2">

      <!-- Thẻ 1: Sách đang mượn -->
      <div class="glass-card card-hover p-5 sm:p-6 flex items-center justify-between relative overflow-hidden group">
        <div class="absolute -right-8 -bottom-8 w-28 h-28 rounded-full bg-indigo-500/10 blur-xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
        <div class="space-y-1.5 z-10">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Tình trạng sách mượn</span>
          </div>
          <div class="flex items-baseline gap-2.5">
            <span class="text-3xl sm:text-4xl font-extrabold text-slate-800 tracking-tight"><%= activeBorrowings ? activeBorrowings.length : 0 %></span>
            <span class="text-sm font-semibold text-slate-700">Sách đang mượn</span>
          </div>
          <p class="text-xs text-slate-500 flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-indigo-500 inline-block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Hạn mức tối đa <strong>3 cuốn</strong> / học sinh
          </p>
        </div>
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-[#818cf8] to-[#4f46e5] flex items-center justify-center text-white shadow-lg group-hover:scale-105 transition-transform duration-300 z-10" style="box-shadow:0 8px 20px rgba(79,70,229,0.35);">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
      </div>

      <!-- Thẻ 2: Thông báo chưa đọc -->
      <div class="glass-card card-hover p-5 sm:p-6 flex items-center justify-between relative overflow-hidden group">
        <div class="absolute -right-8 -bottom-8 w-28 h-28 rounded-full bg-amber-500/10 blur-xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
        <div class="space-y-1.5 z-10">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Hộp thư thông báo</span>
            <% if (unreadCount > 0) { %>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Cập nhật mới</span>
            <% } %>
          </div>
          <div class="flex items-baseline gap-2.5">
            <span class="text-3xl sm:text-4xl font-extrabold text-amber-600 tracking-tight"><%= unreadCount || 0 %></span>
            <span class="text-sm font-semibold text-slate-700">Thông báo chưa đọc</span>
          </div>
          <div>
            <a href="/student/notifications" class="text-xs font-semibold text-amber-700 hover:text-amber-800 inline-flex items-center gap-1 no-underline">
              <span>→ Xem chi tiết thông báo</span>
            </a>
          </div>
        </div>
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-[#fbbf24] to-[#d97706] flex items-center justify-center text-white shadow-lg group-hover:scale-105 transition-transform duration-300 z-10" style="box-shadow:0 8px 20px rgba(217,119,6,0.35);">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </div>
      </div>
    </div>

    <!-- Vùng 3: Danh sách sách đang mượn -->
    <div class="glass-card p-6 fade-in-up stagger-3 space-y-4">

      <!-- Card header -->
      <div class="flex items-center justify-between border-b border-slate-200/70 pb-4">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-800">Sách đang mượn</h2>
            <p class="text-xs text-slate-500">Các đầu sách hiện do bạn mượn và cần hoàn trả trước ngày quy định</p>
          </div>
        </div>
        <a href="/student/my-borrowings" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 hover:underline flex items-center gap-1 no-underline">
          Lịch sử mượn trả →
        </a>
      </div>

      <!-- Danh sách sách -->
      <div class="space-y-4">
        <% if (activeBorrowings && activeBorrowings.length > 0) { %>
          <% activeBorrowings.forEach(function(b, idx) { %>
            <%
              const today    = new Date();
              const dueDate  = new Date(b.dueDate);
              const isOverdue= today > dueDate;
              const daysLeft = Math.ceil((dueDate - today) / (1000*60*60*24));
              const overDays = isOverdue ? Math.floor((today - dueDate) / (1000*60*60*24)) : 0;
              const fine     = overDays * (parseInt(process.env.FINE_PER_DAY) || 50000);
              function fmtD(d){ if(!d)return'—'; return new Date(d).toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}); }
            %>
            <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-5 group <%= isOverdue ? 'bg-rose-50/80 hover:bg-rose-50 border border-rose-200/80' : 'bg-white/50 hover:bg-white/80 border border-white/70' %> rounded-2xl transition-all duration-300 shadow-sm">
              <div class="flex items-start sm:items-center space-x-4 sm:space-x-5">
                <div class="w-12 h-12 rounded-xl <%= isOverdue ? 'bg-rose-100 border border-rose-200 text-rose-600' : 'bg-blue-50 border border-blue-100 text-blue-600' %> flex items-center justify-center shrink-0 font-bold text-base shadow-sm">
                  <%= String(idx+1).padStart(2,'0') %>
                </div>
                <div class="space-y-2.5">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h3 class="font-bold text-base sm:text-lg leading-snug <%= isOverdue ? 'text-rose-900' : 'text-slate-800 group-hover:text-indigo-600' %> transition-colors">
                      <%= b.bookId ? b.bookId.title : '—' %>
                    </h3>
                    <% if (isOverdue) { %>
                    <span class="text-[11px] font-bold text-rose-700 bg-rose-200/70 px-2 py-0.5 rounded-full border border-rose-300/60">Cần hoàn trả</span>
                    <% } %>
                  </div>
                  <div class="flex flex-wrap items-center gap-y-2 gap-x-3 text-xs <%= isOverdue ? 'text-rose-800/80' : 'text-slate-500' %>">
                    <span>Tác giả: <strong class="<%= isOverdue ? 'text-slate-800' : 'text-slate-700' %> font-medium"><%= b.bookId ? b.bookId.author : '—' %></strong></span>
                    <span class="<%= isOverdue ? 'text-rose-300' : 'text-slate-300' %>">•</span>
                    <span>Ngày mượn: <strong class="<%= isOverdue ? 'text-slate-800' : 'text-slate-700' %> font-medium"><%= fmtD(b.borrowDate) %></strong></span>
                    <span class="<%= isOverdue ? 'text-rose-300' : 'text-slate-300' %>">•</span>
                    <span>Hạn trả: <strong class="<%= isOverdue ? 'text-rose-700 font-bold' : 'text-slate-800 font-semibold' %>"><%= fmtD(b.dueDate) %></strong></span>
                    <% if (isOverdue && fine > 0) { %>
                    <span class="text-rose-300">•</span>
                    <span class="text-rose-600 font-bold bg-rose-100/80 px-2 py-0.5 rounded border border-rose-200/60">Phạt trễ: <%= fine.toLocaleString('vi-VN') %> đ (50.000 đ / ngày)</span>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Badge deadline -->
              <div class="self-end sm:self-center shrink-0 pt-2 sm:pt-0">
                <% if (isOverdue) { %>
                <span class="badge-red text-xs font-semibold px-3.5 py-2 rounded-full inline-flex items-center gap-2 shadow-sm">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                  ⚠ Quá hạn <%= overDays %> ngày
                </span>
                <% } else if (daysLeft <= 2) { %>
                <span class="badge-amber text-xs font-semibold px-3.5 py-2 rounded-full inline-flex items-center gap-2 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                  Còn <%= daysLeft %> ngày
                </span>
                <% } else { %>
                <span class="badge-blue text-xs font-semibold px-3.5 py-2 rounded-full inline-flex items-center gap-2 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                  Còn <%= daysLeft %> ngày
                </span>
                <% } %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
        <div class="py-10 text-center text-slate-400">
          <div class="text-4xl mb-3">📚</div>
          <div class="text-sm font-medium">Bạn chưa mượn sách nào</div>
          <a href="/student/books" class="mt-2 inline-block text-xs text-emerald-600 font-semibold no-underline">→ Tìm kiếm sách để mượn</a>
        </div>
        <% } %>
      </div>

      <!-- Footer note -->
      <div class="pt-2 text-xs text-slate-500 flex items-center justify-between border-t border-slate-200/60">
        <span>💡 Bạn có thể đến bàn thủ thư thư viện để tiến hành gia hạn hoặc hoàn trả sách.</span>
