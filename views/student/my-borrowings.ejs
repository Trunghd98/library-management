<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lịch sử mượn sách · <%= libraryName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Plus Jakarta Sans',sans-serif;background:linear-gradient(135deg,#e8f5e9 0%,#f0fdf4 50%,#e0f2fe 100%);background-attachment:fixed;min-height:100vh;color:#1e293b;}
    .font-mono{font-family:'JetBrains Mono',monospace;}
    .navbar-student{background:rgba(22,163,74,0.88);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.2);box-shadow:0 4px 24px rgba(22,163,74,0.25);position:sticky;top:0;z-index:100;}
    .glass-card{background:rgba(255,255,255,0.65);backdrop-filter:blur(12px) saturate(180%);-webkit-backdrop-filter:blur(12px) saturate(180%);border:1px solid rgba(255,255,255,0.8);box-shadow:0 8px 32px rgba(79,70,229,0.10),0 2px 8px rgba(0,0,0,0.06);border-radius:16px;}
    .card-hover{transition:transform 0.3s ease,box-shadow 0.3s ease;}
    .card-hover:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(79,70,229,0.15),0 4px 12px rgba(0,0,0,0.08);}
    thead tr{background:rgba(79,70,229,0.06);}
    tbody tr{transition:background 0.15s ease;}
    tbody tr:hover{background:rgba(79,70,229,0.04);}
    tbody tr.overdue{background:rgba(220,38,38,0.06);}
    tbody tr.overdue:hover{background:rgba(220,38,38,0.10);}
    .badge-blue{background-color:#2563eb;color:#fff;box-shadow:0 2px 8px rgba(37,99,235,0.40);}
    .badge-red{background-color:#dc2626;color:#fff;box-shadow:0 2px 8px rgba(220,38,38,0.40);}
    .badge-green{background-color:#16a34a;color:#fff;box-shadow:0 2px 8px rgba(22,163,74,0.40);}
    .badge-amber{background-color:#d97706;color:#fff;box-shadow:0 2px 8px rgba(217,119,6,0.40);}
    .badge-gray{background-color:#64748b;color:#fff;}
    .btn-green-primary{background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 4px 12px rgba(22,163,74,0.30);color:#fff;transition:all 0.2s ease;}
    .btn-green-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(22,163,74,0.45);}
    .btn-outline-indigo{background:rgba(255,255,255,0.6);border:1.5px solid #4f46e5;color:#4f46e5;transition:all 0.2s ease;}
    .btn-outline-indigo:hover{background:#4f46e5;color:#fff;transform:translateY(-2px);box-shadow:0 4px 12px rgba(79,70,229,0.25);}
    .btn-outline-green{background:rgba(255,255,255,0.6);border:1.5px solid #16a34a;color:#16a34a;transition:all 0.2s ease;}
    .btn-outline-green:hover{background:#16a34a;color:#fff;transform:translateY(-2px);box-shadow:0 4px 12px rgba(22,163,74,0.25);}
    input,select{background:rgba(255,255,255,0.85);border:1.5px solid rgba(226,232,240,0.80);border-radius:10px;transition:all 0.2s ease;}
    input:focus,select:focus{background:rgba(255,255,255,0.98);border-color:#16a34a;box-shadow:0 0 0 3px rgba(22,163,74,0.2);outline:none;}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .page-content{animation:fadeInUp 0.35s ease both;}
    ::-webkit-scrollbar{width:6px;height:6px;} ::-webkit-scrollbar-track{background:transparent;} ::-webkit-scrollbar-thumb{background:rgba(22,163,74,0.3);border-radius:3px;}
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- NAVBAR -->
  <header class="navbar-student">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center space-x-6 sm:space-x-8">
        <a href="/student" class="flex items-center space-x-2.5 group no-underline text-white">
          <div class="w-9 h-9 rounded-xl bg-white/20 flex items-center justify-center text-lg shadow-inner group-hover:scale-105 transition-transform">📚</div>
          <div class="font-bold text-base sm:text-lg leading-tight tracking-tight"><%= libraryName %></div>
        </a>
        <nav class="hidden md:flex items-center space-x-1">
          <a href="/student" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-white/85 hover:text-white hover:bg-white/10 text-sm font-medium transition-colors no-underline">
            <svg class="w-4 h-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Trang chủ</span>
          </a>
          <a href="/student/books" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-xl text-white/85 hover:text-white hover:bg-white/10 text-sm font-medium transition-colors no-underline">
            <svg class="w-4 h-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <span>Tra cứu sách</span>
          </a>
          <!-- ACTIVE: Lịch sử mượn -->
          <a href="/student/my-borrowings" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-xl bg-white/25 text-white shadow-sm border border-white/30 text-sm font-semibold transition-all no-underline">
            <svg class="w-4 h-4 text-emerald-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Lịch sử mượn</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center space-x-3 sm:space-x-4">
        <!-- Bell -->
        <a href="/student/notifications" title="Thông báo" class="relative p-2 rounded-xl bg-white/15 hover:bg-white/25 text-white transition-all no-underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </a>
        <!-- User info -->
        <div class="hidden sm:flex items-center space-x-2.5 text-right pl-1">
          <div>
            <div class="flex items-center justify-end space-x-1.5">
              <span class="inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-white/20 text-white border border-white/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span><span>Học sinh</span>
              </span>
              <span class="text-white font-semibold text-sm"><%= user ? user.fullName : '' %></span>
            </div>
            <div class="text-white/80 text-xs font-mono font-medium mt-0.5"><%= user ? user.studentId : '' %><% if(user&&user.class){%> · Lớp <%= user.class %><% } %></div>
          </div>
        </div>
        <!-- Logout -->
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold border border-white/20 transition-all shadow-sm cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <span class="hidden md:inline">Đăng xuất</span>
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- CONTENT -->
  <main class="flex-grow max-w-[1100px] w-full mx-auto px-4 sm:px-6 py-7 page-content">

    <%
      // Precompute stats
      const total      = borrowings ? borrowings.length : 0;
      const cntActive  = borrowings ? borrowings.filter(b=>b.status==='borrowing').length : 0;
      const cntOverdue = borrowings ? borrowings.filter(b=>b.status==='overdue').length : 0;
      const cntRet     = borrowings ? borrowings.filter(b=>b.status==='returned').length : 0;
      const totalFine  = borrowings ? borrowings.reduce((sum,b)=>sum+(b.fine||0),0) : 0;
      function fmtD(d){ if(!d)return'—'; return new Date(d).toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'}); }
    %>

    <!-- Header + breadcrumb + actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
          <a href="/student" class="hover:text-emerald-700 transition-colors no-underline text-slate-500">Trang chủ</a>
          <span>/</span>
          <span class="text-slate-700 font-semibold">Lịch sử mượn sách</span>
        </div>
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2.5 tracking-tight">
          <span>📋</span><span>Lịch sử mượn sách</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Theo dõi toàn bộ quá trình mượn, gia hạn, trả sách và trạng thái tiền phạt cá nhân</p>
      </div>
      <div class="flex items-center space-x-3 self-start sm:self-auto">
        <a href="/student/books" class="btn-outline-green flex items-center space-x-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold shadow-sm no-underline">
          <span>🔍</span><span>Tra cứu sách mới</span>
        </a>
        <a href="/student" class="btn-outline-indigo flex items-center space-x-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold shadow-sm no-underline">
          <span>🏠</span><span>Về trang chủ</span>
        </a>
      </div>
    </div>

    <!-- 3 Summary cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <!-- Tổng phiếu -->
      <div class="glass-card p-4 flex items-center space-x-3.5 card-hover">
        <div class="w-11 h-11 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-xl text-indigo-600 shadow-sm">📚</div>
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Tổng phiếu mượn</div>
          <div class="text-xl font-bold text-slate-800"><%= total %> <span class="text-xs font-normal text-slate-500">lượt</span></div>
        </div>
      </div>
      <!-- Đang giữ -->
      <div class="glass-card p-4 flex items-center space-x-3.5 card-hover">
        <div class="w-11 h-11 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-xl text-blue-600 shadow-sm">⏳</div>
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Đang giữ sách</div>
          <div class="text-xl font-bold text-blue-600"><%= cntActive + cntOverdue %> <span class="text-xs font-normal text-slate-500">cuốn (tối đa 3)</span></div>
        </div>
      </div>
      <!-- Tiền phạt -->
      <div class="glass-card p-4 flex items-center space-x-3.5 card-hover">
        <div class="w-11 h-11 rounded-2xl bg-rose-50 border border-rose-100 flex items-center justify-center text-xl text-rose-600 shadow-sm">💰</div>
        <div>
          <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Tiền phạt ghi nhận</div>
          <div class="text-xl font-bold text-rose-600"><%= totalFine > 0 ? totalFine.toLocaleString('vi-VN') + ' đ' : '0 đ' %></div>
        </div>
      </div>
    </div>

    <!-- Filter toolbar -->
    <div class="glass-card p-4 sm:p-5 mb-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-500 mr-1 hidden sm:inline">Lọc theo:</span>
          <a href="/student/my-borrowings" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all no-underline <%= !status ? 'bg-slate-800 text-white shadow-sm' : 'bg-white/70 text-slate-600 border border-slate-200 hover:bg-slate-50' %>">
            Tất cả (<%= total %>)
          </a>
          <a href="/student/my-borrowings?status=borrowing" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all no-underline <%= status==='borrowing' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white/70 text-blue-700 border border-blue-300 hover:bg-blue-50' %>">
            Đang mượn (<%= cntActive %>)
          </a>
          <a href="/student/my-borrowings?status=overdue" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all no-underline <%= status==='overdue' ? 'bg-rose-600 text-white shadow-sm' : 'bg-white/70 text-rose-700 border border-rose-300 hover:bg-rose-50' %>">
            Quá hạn (<%= cntOverdue %>)
          </a>
          <a href="/student/my-borrowings?status=returned" class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all no-underline <%= status==='returned' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white/70 text-emerald-700 border border-emerald-300 hover:bg-emerald-50' %>">
            Đã trả (<%= cntRet %>)
          </a>
        </div>
      </div>
    </div>

    <!-- Table card -->
    <div class="glass-card overflow-hidden shadow-lg border border-white/80">

      <!-- Table header bar -->
      <div class="px-5 py-4 border-b border-slate-200/70 bg-white/40 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center space-x-2">
          <span class="text-emerald-600 font-bold text-base">📚</span>
          <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wide">Chi tiết danh sách mượn trả</h2>
        </div>
        <div class="text-xs text-slate-500 font-medium">
          Mã học sinh: <span class="font-mono font-semibold text-emerald-700"><%= user ? user.studentId : '' %></span>
          <% if(user){ %> · <%= user.fullName %><% } %>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200/80">
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-center w-12">#</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Tên sách &amp; Thông tin</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Tác giả</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap">Ngày mượn</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap">Hạn trả</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap">Ngày trả</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-center whitespace-nowrap">Trạng thái</th>
              <th class="py-3.5 px-4 text-[11px] font-bold text-slate-500 uppercase tracking-wider text-right whitespace-nowrap">Tiền phạt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/70 text-sm">
            <% if (borrowings && borrowings.length > 0) { %>
              <%
                // filter by status if query param exists
                const filtered = status ? borrowings.filter(b=>b.status===status) : borrowings;
              %>
              <% if (filtered.length === 0) { %>
              <tr>
                <td colspan="8" class="py-14 text-center text-slate-400">
                  <div class="text-3xl mb-2">📭</div>
                  <div class="text-sm">Không có phiếu mượn nào trong trạng thái này</div>
                </td>
              </tr>
              <% } %>
              <% filtered.forEach(function(b, idx) { %>
                <%
                  const isOverdue  = b.status === 'overdue';
                  const isBorrow   = b.status === 'borrowing';
                  const isReturned = b.status === 'returned';
                  const today      = new Date();
                  const dueDate    = new Date(b.dueDate);
                  const daysLeft   = !isReturned ? Math.ceil((dueDate - today)/(1000*60*60*24)) : null;
                  const overDays   = isOverdue ? Math.floor((today - dueDate)/(1000*60*60*24)) : 0;
                %>
                <tr class="<%= isOverdue ? 'overdue' : '' %>">
                  <td class="py-4 px-4 text-center font-mono text-xs text-slate-400"><%= idx + 1 %></td>

                  <td class="py-4 px-4">
                    <div class="font-bold text-slate-800 hover:text-emerald-700 transition-colors cursor-default">
                      <%= b.bookId ? b.bookId.title : '—' %>
                    </div>
                    <div class="flex items-center space-x-2 mt-1">
                      <% if (b.bookId && b.bookId.category) { %>
                      <span class="badge-gray px-2 py-0.5 rounded-full text-[10px] font-medium"><%= b.bookId.category %></span>
                      <% } %>
                      <% if (isOverdue) { %>
                      <span class="text-[11px] text-rose-600 font-medium flex items-center gap-1"><span>⚠️</span> Quá hạn <%= overDays %> ngày</span>
                      <% } else if (isBorrow && daysLeft !== null) { %>
                      <span class="text-[11px] <%= daysLeft <= 2 ? 'text-amber-600' : 'text-blue-600' %> font-medium flex items-center gap-1">
                        <span><%= daysLeft <= 2 ? '⚠️' : '⏱️' %></span> <%= daysLeft > 0 ? 'Còn ' + daysLeft + ' ngày' : 'Hết hạn hôm nay' %>
                      </span>
                      <% } else if (isReturned) { %>
                      <span class="text-[11px] text-emerald-700 font-medium">Đã hoàn tất</span>
                      <% } %>
                    </div>
                  </td>

                  <td class="py-4 px-4 text-xs text-slate-600 font-medium"><%= b.bookId ? b.bookId.author : '—' %></td>

                  <td class="py-4 px-4 text-xs text-slate-600 whitespace-nowrap font-mono"><%= fmtD(b.borrowDate) %></td>

                  <td class="py-4 px-4 text-xs whitespace-nowrap font-mono <%= isOverdue ? 'font-bold text-rose-600' : 'text-slate-700 font-semibold' %>">
                    <%= fmtD(b.dueDate) %>
                  </td>

                  <td class="py-4 px-4 text-xs whitespace-nowrap font-mono text-center <%= isReturned ? 'font-semibold text-emerald-700' : 'text-slate-400' %>">
                    <%= isReturned ? fmtD(b.returnDate) : '—' %>
                  </td>

                  <td class="py-4 px-4 text-center whitespace-nowrap">
                    <% if (isOverdue) { %>
                    <span class="badge-red px-2.5 py-1 rounded-full text-[11px] font-semibold inline-flex items-center gap-1"><span>⚠️</span> Quá hạn</span>
                    <% } else if (isBorrow) { %>
                    <span class="badge-blue px-2.5 py-1 rounded-full text-[11px] font-semibold inline-flex items-center gap-1"><span>📖</span> Đang mượn</span>
                    <% } else { %>
                    <span class="badge-green px-2.5 py-1 rounded-full text-[11px] font-semibold inline-flex items-center gap-1"><span>✓</span> Đã trả</span>
                    <% } %>
                  </td>

                  <td class="py-4 px-4 text-right whitespace-nowrap font-mono text-xs <%= (b.fine && b.fine > 0) ? 'font-bold text-rose-600 text-sm' : 'text-slate-400' %>">
                    <%= (b.fine && b.fine > 0) ? b.fine.toLocaleString('vi-VN') + ' đ' : '—' %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
            <tr>
              <td colspan="8" class="py-16 text-center text-slate-400">
                <div class="text-4xl mb-3">📭</div>
                <div class="text-sm font-medium">Bạn chưa có lịch sử mượn sách</div>
                <a href="/student/books" class="mt-2 inline-block text-xs text-emerald-600 font-semibold no-underline">→ Tra cứu sách để mượn</a>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Table footer -->
      <div class="px-5 py-3.5 bg-white/50 border-t border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
        <div>
          Hiển thị <span class="font-bold text-slate-700"><%= borrowings ? borrowings.length : 0 %></span> phiếu mượn
          <% if (cntActive + cntOverdue > 0) { %> · <span class="text-blue-600 font-medium"><%= cntActive + cntOverdue %> cuốn đang giữ</span><% } %>
          <% if (cntOverdue > 0) { %>, <span class="text-rose-600 font-medium"><%= cntOverdue %> quá hạn</span><% } %>
        </div>
        <div class="flex items-center space-x-1.5 self-end sm:self-auto">
          <span class="w-2 h-2 rounded-full bg-rose-500 inline-block"></span>
          <span>Dòng viền đỏ biểu thị phiếu quá hạn cần mang trả tại quầy thư viện</span>
        </div>
      </div>
    </div>

    <!-- Info box -->
    <div class="mt-6 p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200/80 flex items-start space-x-3.5 backdrop-blur-sm">
      <div class="text-xl text-emerald-600 shrink-0 mt-0.5">ℹ️</div>
      <div class="text-xs sm:text-sm text-emerald-900 leading-relaxed">
        <p class="font-bold mb-0.5">Quy định mượn trả sách dành cho học sinh:</p>
        <p class="text-emerald-800">
          Thời hạn mượn chuẩn là <span class="font-semibold">7 ngày</span>. Học sinh được mượn tối đa <span class="font-semibold">3 cuốn sách</span> cùng lúc. Sách quá hạn chưa hoàn trả sẽ tính phí phạt <span class="font-semibold text-rose-700">50.000 đ/ngày</span>. Vui lòng liên hệ thủ thư tại quầy để được hướng dẫn trả sách hoặc gia hạn nếu cần.
        </p>
      </div>
    </div>

  </main>

